      "term": "平方差",
      "definition": "兩個平方相減的形式 a²-b²。"
    },
    {
      "term": "抵消",
      "definition": "+ab 與 -ab 相加為 0。"
    }
  ],
  "notation": [
    {
      "symbol": "(a+b)(a−b)",
      "meaning": "a²−b²。"
