{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "U05 semantic review",
  "type": "object",
  "required": [
    "questionId",
    "contentSha256",
    "independentSolution",
    "derivedAnswer",
    "storedAnswer",
    "answerMatch",
    "uniqueCorrectAnswer",
    "ambiguityChecks",
    "difficultyReason",
    "reviewerDecision",
    "reviewerNote"
  ],
  "properties": {
    "reviewerDecision": {
      "const": "pass"
    },
    "answerMatch": {
      "const": true
    },
    "uniqueCorrectAnswer": {
      "const": true
    }
  }
}
