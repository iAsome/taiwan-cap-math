  "prerequisites": [
    {
      "skillId": "quadratic-solve-by-factoring",
      "requiredLevel": "能說明前一技能的核心規則並完成基本計算，不只記答案。"
    }
  ],
  "prerequisiteBridge": "承接整理後因式分解；當不能整數分解時，基本配方提供系統化方法。",
  "glossary": [
    {
      "term": "基本配方",
      "definition": "針對 x² 係數為 1 的二次式，補上一次項係數一半的平方。"
    },
    {
      "term": "補數",
      "definition": "為形成完全平方而加入的 (b/2)²。"
    },
    {
      "term": "等價方程式",
      "definition": "解集合完全相同的方程式。"
    }
  ],
  "notation": [
    {
      "symbol": "x²+bx+(b/2)²=(x+b/2)²",
      "meaning": "首項係數為 1 的配方規則。"
    }
  ],
  "conceptNarrative": [
    "首項係數為一的配方法，是把平方項與一次項補成完全平方。將一次項係數除以二再平方，所得補數必為非負；解方程式時必須在等號兩邊同加補數，才能保持解集合不變。完成後再開平方並保留正負兩支。",
    "改寫一般二次式時，可在式內加上補數並立刻扣回同一數，形成平方加常數的形式。平方外常數要把原常數與補扣數正確合併。由於平方永遠非負，也能直接判斷式子的最小值及取得最小值的未知數位置。",
    "配方後右側若為正數，通常產生兩個實根；等於零只有一個相異根；小於零則無實根。右側不是完全平方數時可保留最簡根式。情境或區間題仍須先列出全部代數根，再依正值、閉區間等限制篩選。"
  ],
  "formalDefinitions": [
    {
      "name": "基本配方公式",
      "statement": "x²+bx=(x+b/2)²-(b/2)²。"
    }
  ],
  "formulas": [
    {
      "formula": "x²+bx+c=0 ⇒ (x+b/2)²=(b/2)²-c",
      "conditions": [
        "x² 係數為 1"
      ],
      "meaning": "直接得到平方形式。"
    }
  ],
  "nonApplicableCases": [
    "x² 係數不為 1 時應先使用一般配方流程。",
    "補數不是 b²，而是 (b/2)²。",
    "只把左邊改寫但忘記常數調整會改變式值。",
    "右邊負數時在實數範圍無解。"
  ],
  "method": [
    {
      "step": 1,
      "instruction": "把常數移到右邊。",
      "check": "左邊是否只剩 x²+bx？"
    },
    {
      "step": 2,
      "instruction": "計算 (b/2)²。",
      "check": "負 b 平方後是否為正？"
    },
    {
      "step": 3,
      "instruction": "兩邊同加補數。",
      "check": "等式是否保持平衡？"
    },
    {
      "step": 4,
      "instruction": "左邊寫成完全平方。",
      "check": "中間項展開是否為 bx？"
    },
    {
      "step": 5,
      "instruction": "開平方並化簡。",
      "check": "± 與根式是否完整？"
    }
  ],
  "workedExamples": [
    {
      "exampleId": "L1",
      "prompt": "補成 x²+4x+□=(x+2)²。",
      "solutionSteps": [
        "取一次項係數四的一半為二。",
        "將二平方得到補數四。",
        "展開右側核對中間項與常數。"
      ],
      "answer": "□=4。",
      "why": "完全平方的中間項是兩倍的未知數乘括號常數，因此先取半係數；補數是該常數的平方。展開回查可同時確認一次項四倍與末項四。"
    },
    {
      "exampleId": "L2",
      "prompt": "用配方法解 x²−6x+5=0。",
      "solutionSteps": [
        "移常數得 x²−6x=−5。",
        "兩邊同加九，成 (x−3)²=4。",
        "開平方並解 x−3=±2。"
      ],
      "answer": "x=1 或 x=5。",
      "why": "負六的一半是負三，平方補九；兩邊同步補數才維持等值。右側四開平方有正負二兩支，分別與中心三合併得到兩根。"
    },
    {
      "exampleId": "L3",
      "prompt": "用配方法解 x²+10x+9=0。",
      "solutionSteps": [
        "移常數得 x²+10x=−9。",
        "兩邊加二十五，成 (x+5)²=16。",
        "解 x+5=±4 並列兩根。"
      ],
      "answer": "x=−1 或 x=−9。",
      "why": "十的一半為五，補二十五後左側成和的平方；開平方得到正四與負四，再減五。只取正平方根會漏掉負九這個合法根。"
    },
    {
      "exampleId": "L4",
      "prompt": "用配方法解 x²+6x+1=0。",
      "solutionSteps": [
        "移常數並補九，得 (x+3)²=8。",
        "開平方得 x+3=±√8。",
        "化簡根式並移項。"
      ],
      "answer": "x=−3±2√2。",
      "why": "右側八不是完全平方數，根式可保留但應提出平方因數四，化為二根號二；中心位移是負三，且正負兩個根都必須保留。"
    }
  ],
  "commonMistakes": [
    {
      "mistake": "x²-6x 補 -9。",
      "why": "把一次項負號帶進平方結果。",
      "correction": "(-3)²=9，補數為正。"
    },
    {
      "mistake": "補數取 b²。",
      "why": "忘記先除以 2。",
      "correction": "使用 (b/2)²。"
    },
    {
      "mistake": "兩邊補不同數。",
      "why": "方程式不再等價。",
      "correction": "同步加同一補數。"
    },
    {
      "mistake": "完全平方括號符號寫反。",
      "why": "中間項符號不符。",
      "correction": "展開檢查 2px。"
    },
    {
      "mistake": "根式 8 不化簡。",
      "why": "答案不夠簡潔。",
      "correction": "√8=2√2。"
    },
    {
      "mistake": "只保留一個平方根。",
      "why": "漏根。",
      "correction": "使用 ±。"
    }
  ],
  "selfCheck": [
