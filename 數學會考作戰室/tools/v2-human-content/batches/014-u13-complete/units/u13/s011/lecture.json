  "learningOutcomes": [
    "能把標準式係數正確代入求根公式。",
    "能分段計算 -b、Δ、2a 降低符號錯誤。",
    "能化簡分數與根式。",
    "能在整數、分數與無理根題型中保持答案完整。"
  ],
  "prerequisites": [
    {
      "skillId": "quadratic-check-root",
      "requiredLevel": "能說明前一技能的核心規則並完成基本計算，不只記答案。"
    }
  ],
  "prerequisiteBridge": "承接驗根技能，把公式求得的候選值以穩定流程產生並檢查。",
  "glossary": [
    {
      "term": "基本代入",
      "definition": "不重新推導公式，依固定欄位代入 a、b、c 並完成運算。"
    },
    {
      "term": "分子",
      "definition": "公式中 -b±√Δ 的整體。"
    },
    {
      "term": "分母",
      "definition": "公式中 2a 的整體。"
    },
    {
      "term": "最簡根式",
      "definition": "根號內不再含大於 1 的完全平方因數。"
    }
  ],
  "notation": [
    {
      "symbol": "a",
      "meaning": "x² 的係數。"
    },
    {
      "symbol": "b",
      "meaning": "x 的係數，含正負號。"
    },
    {
      "symbol": "c",
      "meaning": "常數項，含正負號。"
    },
    {
      "symbol": "Δ=b²-4ac",
      "meaning": "先獨立計算的判別式。"
    }
  ],
  "conceptNarrative": [
    "本技能重點是穩定的計算流程，不再討論公式推導。",
    "最好建立四格草稿：a、b、c、Δ，再代入公式。",
    "b 為負數時，-b 與 b² 是兩個不同動作，都應使用括號。",
    "當 Δ 是完全平方數，常得到有理根；否則保留最簡根式。",
    "最後可用代入或根的和與積做快速合理性檢查，但正式驗根仍以代回為準。",
    "求根公式的穩定用法是把係數辯識、判別式、正負兩分支與最後化簡分開處理。一次項或常數項為負時，a、b、c 都要連同符號代入；根式先抽出完全平方因數，分數線則覆蓋整個分子。答案化簡後再代回原方程式，可同時發現負號、分母與根式係數的錯誤。"
  ],
  "formalDefinitions": [
    {
      "name": "公式解基本流程",
      "statement": "標準式→係數→判別式→代入→化簡→驗算。"
    }
  ],
  "formulas": [
    {
      "formula": "x=(-b±√Δ)/(2a)",
      "conditions": [
        "a≠0",
        "Δ≥0 才有實數根"
      ],
      "meaning": "直接求兩個公式分支。"
    }
  ],
  "nonApplicableCases": [
    "未整理成標準式不能直接填係數。",
    "判別式為負時本單元不進入複數。",
    "約分時必須同時作用於整個分子，不可只約其中一項。",
    "根式相加減需有相同根號部分，不能把 ±√13 任意改寫。"
  ],
  "method": [
    {
      "step": 1,
      "instruction": "整理標準式並寫 a、b、c。",
      "check": "符號是否完整？"
    },
    {
      "step": 2,
      "instruction": "獨立計算 Δ。",
      "check": "乘法與平方是否先算？"
    },
    {
      "step": 3,
      "instruction": "寫出 -b±√Δ。",
      "check": "± 是否保留？"
    },
    {
      "step": 4,
      "instruction": "整體除以 2a。",
      "check": "分母是否包含 a？"
    },
    {
      "step": 5,
      "instruction": "分別化簡兩根並驗算。",
      "check": "分數與根式是否最簡？"
    }
  ],
  "workedExamples": [
    {
      "exampleId": "L1",
      "prompt": "解 x²+3x-4=0。",
      "solutionSteps": [
        "a=1，b=3，c=-4，Δ=3²-4·1·(-4)=25。",
        "代入公式得 x=(-3±5)/2。",
        "分別化簡兩個分支，得 x=1 或 x=-4，代回均成立。"
      ],
      "answer": "x=1 或 x=-4。",
      "why": "係數必須連同符號記錄，c 是負四，因此判別式中的負四倍 ac 會增加十六。兩個正負分支都要整體除以二，再代回原式才能確認沒有符號或分母錯誤。"
    },
    {
      "exampleId": "L2",
      "prompt": "解 x²-4x-1=0。",
      "solutionSteps": [
        "a=1，b=-4，c=-1，Δ=(-4)²-4·1·(-1)=20。",
        "x=(4±√20)/2=(4±2√5)/2。",
        "分子每項同除以二，得 x=2±√5。"
      ],
      "answer": "x=2±√5。",
      "why": "b 為負數時，公式的 -b 會成為正四，這與 b² 的平方運算是兩個不同步驟。根號二十先抽出四得二根號五，再讓整個分子除以二，才會得到最簡根式。"
    },
    {
      "exampleId": "L3",
      "prompt": "解 2x²-3x-2=0。",
      "solutionSteps": [
        "a=2，b=-3，c=-2，Δ=(-3)²-4·2·(-2)=25。",
        "x=(3±5)/4。",
        "正分支得二，負分支得負二分之一，兩者代回皆成立。"
      ],
      "answer": "x=2 或 x=-1/2。",
      "why": "首項係數為二，所以公式分母必須是二 a 等於四，不能只寫二。正負分支要分別化簡，三減五得負二，除以四後是負二分之一，這個分數根不可遗漏。"
    },
    {
      "exampleId": "L4",
      "prompt": "解 3x²+x-1=0。",
      "solutionSteps": [
        "a=3，b=1，c=-1，Δ=1²-4·3·(-1)=13。",
        "代入公式得 x=(-1±√13)/6。",
        "十三沒有可抽出的平方因數，分子與六也不能整體約分。"
      ],
      "answer": "x=(-1±√13)/6。",
      "why": "判別式十三大於零，所以正負分支給出兩個相異實根。由於十三不含四、九等平方因數，根號十三已是最簡；分子的負一與根式也不能各自任意除以分母。"
    },
    {
      "exampleId": "L5",
      "prompt": "解 -2x²+7x-3=0。",
      "solutionSteps": [
        "a=-2，b=7，c=-3，Δ=7²-4·(-2)·(-3)=25。",
        "x=(-7±5)/(-4)。",
        "兩分支分別得二分之一與三，代回負首項原式驗根。"
      ],
      "answer": "x=3 或 x=1/2。",
      "why": "直接使用 a=-2 時，分母為負四，負的分子再除以負分母會得正根。也可先將全式乘以負一，但必須同時改變三個係數；兩種做法都應得到三與二分之一。"
    }
  ],
  "commonMistakes": [
    {
      "mistake": "b=-4 時 -b 仍寫 -4。",
      "why": "雙重負號未處理。",
      "correction": "-(-4)=4。"
    },
    {
      "mistake": "Δ 的 -4ac 漏掉 c 的負號。",
      "why": "未用括號代入。",
      "correction": "寫 -4·a·(c)。"
    },
    {
      "mistake": "分母寫成 2。",
      "why": "漏乘 a。",
      "correction": "完整寫 2a。"
    },
    {
      "mistake": "把 (-3±5)/4 約成 -3±5/4。",
      "why": "分數線範圍錯誤。",
      "correction": "整個分子除以 4。"
    },
    {
      "mistake": "√20 不化簡。",
      "why": "未抽出 4。",
      "correction": "√20=2√5。"
    },
    {
      "mistake": "負 a 題把整式乘 -1 後係數只改一項。",
      "why": "等價變形不完整。",
      "correction": "所有項同乘 -1。"
    }
  ],
  "selfCheck": [
