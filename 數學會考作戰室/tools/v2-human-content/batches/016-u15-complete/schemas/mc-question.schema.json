{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "U15 MC",
  "type": "object",
  "required": [
    "questionId",
    "skillId",
    "difficulty",
    "choices",
    "answerIndex",
    "independentSolution",
    "optionAnalysis",
    "contentAuthority",
    "contentSha256"
  ],
  "properties": {
    "type": {
      "const": "mc"
    },
    "choices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "answerIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "contentAuthority": {
      "const": "CHATGPT_HUMAN_AUTHORED_R1"
    }
  }
}
