    {
      "boundary": "連比預備與 U18",
      "decision": "U06 只處理兩個比例共享中間量時的對齊與合併概念，不教授 U18 的完整連比系統。"
    },
    {
      "boundary": "反比圖形",
      "decision": "限第一象限正數情境的概念判讀，不引入高中函數漸近線術語或負值分支。"
    },
    {
      "boundary": "比例尺",
      "decision": "處理數值比例尺、圖上距離與實際距離之單位換算，不延伸至地理投影。"
    }
  ],
