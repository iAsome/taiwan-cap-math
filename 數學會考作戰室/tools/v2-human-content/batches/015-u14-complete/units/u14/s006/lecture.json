        "得到12。"
      ],
      "answer": "12"
    },
    {
      "exampleId": "L2",
      "prompt": "-9與5的等差中項",
      "reasoning": "(-9+5)÷2。",
      "solutionSteps": [
        "(-9+5)÷2。",
        "得到-2。"
      ],
      "answer": "-2"
    },
    {
      "exampleId": "L3",
      "prompt": "在4與24間插入3項",
      "reasoning": "共有4段，d=(24-4)÷4=5。",
      "solutionSteps": [
        "共有4段，d=(24-4)÷4=5。",
        "依序加5。"
      ],
      "answer": "9、14、19"
    },
    {
      "exampleId": "L4",
      "prompt": "x-2，7，2x+3為連續等差三項",
      "reasoning": "2×7=(x-2)+(2x+3)。",
      "solutionSteps": [
        "2×7=(x-2)+(2x+3)。",
        "14=3x+1。"
      ],
      "answer": "x=13/3"
    }
  ],
