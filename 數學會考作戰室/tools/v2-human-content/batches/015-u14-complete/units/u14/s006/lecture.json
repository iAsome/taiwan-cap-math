  "commonMistakes": [
    {
      "mistake": "把兩端相減再除2",
      "why": "得到的是半差，不是中項值。",
      "correction": "中項用兩端和除2。"
    },
    {
      "mistake": "插入3項只分3段",
      "why": "忽略兩端到第一與最後中項的間隔。",
      "correction": "段數=插入數+1。"
    },
    {
      "mistake": "不保留負號",
      "why": "負數平均會錯。",
      "correction": "先加有號數。"
    },
    {
      "mistake": "把等比中項公式套進來",
      "why": "兩種數列條件不同。",
      "correction": "等差用2b=a+c。"
    },
