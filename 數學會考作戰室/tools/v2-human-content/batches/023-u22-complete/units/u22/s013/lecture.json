      "instruction": "列第一階段",
      "check": "全部可能。"
    },
    {
      "step": 3,
      "instruction": "展開後續",
      "check": "依放回與條件。"
    },
    {
      "step": 4,
      "instruction": "刪非法結果",
      "check": "逐條核對。"
    },
    {
      "step": 5,
      "instruction": "檢查完整與等可能性",
      "check": "計數前再確認。"
    }
  ],
