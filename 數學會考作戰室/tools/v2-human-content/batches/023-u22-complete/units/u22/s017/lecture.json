      "instruction": "各自相乘",
      "check": "保持正負號。"
    },
    {
      "step": 3,
      "instruction": "加總期望",
      "check": "確認單位。"
    },
    {
      "step": 4,
      "instruction": "比較題目指定指標",
      "check": "期望、保證或風險。"
    },
    {
      "step": 5,
      "instruction": "審核語句",
      "check": "拒絕必然、補償與誇大。"
    }
  ],
