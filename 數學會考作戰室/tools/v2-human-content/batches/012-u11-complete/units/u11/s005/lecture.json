    },
    {
      "mistake": "√(-9)=-3。",
      "why": "平方驗算不成立。",
      "correction": "實數範圍無意義。"
    },
    {
      "mistake": "±√9=±9。",
      "why": "先算√9=3。",
      "correction": "結果為±3。"
    },
