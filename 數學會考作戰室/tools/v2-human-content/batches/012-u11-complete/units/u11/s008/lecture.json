    {
      "name": "負值比較",
      "statement": "乘以-1時不等號反向。"
    }
  ],
  "formulas": [
    {
      "formula": "m√n ? √p",
      "conditions": [
        "若兩邊非負，改比較m²n與p。"
      ],
      "meaning": "避免小數近似誤差。"
    }
  ],
  "nonApplicableCases": [
    "平方比較前要確認兩邊非負。",
    "不能只比較根號內數而忽略外係數。",
    "負號會反轉次序。",
    "近似相同不代表相等。"
  ],
  "method": [
