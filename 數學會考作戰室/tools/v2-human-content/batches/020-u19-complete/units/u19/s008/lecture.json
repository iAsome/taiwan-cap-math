  "workedExamples": [
    {
      "exampleId": "s008-L1",
      "prompt": "r=9，θ=80°。",
      "solutionSteps": [
        "80/360=2/9。",
        "L=(2/9)×18π=4π。"
      ],
      "answer": "4π。",
      "level": "basic"
    },
    {
      "exampleId": "s008-L2",
      "prompt": "r=12，L=6π。求θ。",
      "solutionSteps": [
        "整圓周長24π。",
        "6π/24π=1/4，θ=90°。"
      ],
      "answer": "90°。",
      "level": "standard"
    },
    {
      "exampleId": "s008-L3",
      "prompt": "直徑14，θ=180°。",
      "solutionSteps": [
        "r=7。",
        "L=1/2×14π=7π。"
      ],
      "answer": "7π。",
      "level": "advanced"
    },
    {
      "exampleId": "s008-L4",
      "prompt": "r=10，θ=72°，π取3.14。",
      "solutionSteps": [
        "72/360=1/5。",
        "L=1/5×20×3.14=12.56。"
      ],
      "answer": "12.56。",
      "level": "connection"
    }
  ],
