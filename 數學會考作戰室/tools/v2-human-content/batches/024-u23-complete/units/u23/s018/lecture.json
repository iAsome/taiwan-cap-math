  "conceptNarrative": [
    "同一容器的外部體積、內部容量與材料體積是三個不同量；題目目的決定使用哪組尺寸。",
    "液體在等截面容器中的體積等於底面積乘水深；放入完全浸沒物體後，水面上升所增加的體積等於物體排開體積。",
    "材料質量由材料本身體積乘密度；中空物件要先做外體積減內體積。",
    "成本與數量題最後常需向上或向下取整，並將幾何答案轉回元、公斤、桶或件。"
  ],
  "formalDefinitions": [
    [
      "完全浸沒排水",
      "排開液體體積等於物體體積。"
    ],
    [
      "等截面液位",
      "液位高度與液體體積成正比。"
    ],
    [
      "中空材料體積",
      "外部立體積減內部空間體積。"
    ]
  ],
  "formulas": [
    [
      "Δh=V物/B容器",
      [
        "物體完全浸沒",
        "容器底面積固定",
        "不溢出"
      ],
      "排水造成的水面上升。"
    ],
    [
      "m=ρV",
      [
        "密度均勻"
      ],
      "由體積求質量。"
    ]
  ],
  "nonApplicableCases": [
