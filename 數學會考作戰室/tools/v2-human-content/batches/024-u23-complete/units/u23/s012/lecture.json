  "conceptNarrative": [
    "立體剪開攤平不改變各面的面積，所以只要展開圖沒有重疊或拉伸，各面片面積相加即為表面積。",
    "角柱展開圖通常含兩個全等底面與一排長方形側面；圓柱含兩圓與一長方形；圓錐含一圓與一扇形。",
    "圖上未直接標示的邊長可由共享邊判斷，例如長方形側面的一邊對應底面邊長。",
    "題目若問用料，可能需要加黏貼片；若問幾何表面積，黏貼片不算。重疊印刷或開口也要依題意調整。"
  ],
  "formalDefinitions": [
    [
      "展開圖求表面積",
      "將每個實際外表面面片面積恰好計一次。"
    ],
    [
      "圓錐曲側面積",
      "扇形面積=πrl，其中l為母線。"
    ]
  ],
  "formulas": [
    [
      "S=各面片面積總和",
      [
        "面片不重疊",
        "尺寸對應正確"
      ],
      "由展開保持面積。"
    ],
    [
      "圓柱側面=圓周×高",
      [
        "側面展開為長方形"
      ],
      "長方形長為2πr。"
    ],
    [
      "圓錐側面=πrl",
      [
        "完整直圓錐"
      ],
      "扇形弧長等於底圓周。"
    ]
  ],
