  "glossary": [
    [
      "錐體",
      "只有一個底面，側面向同一頂點收束的立體。"
    ],
    [
      "錐高",
      "頂點到底面所在平面的垂直距離。"
    ],
    [
      "母線",
      "圓錐頂點到底圓周上的斜線段，通常不是高。"
    ],
    [
      "同底等高",
      "底面相同或等面積，且垂直高相同。"
    ]
  ],
  "notation": [
    [
      "V",
      "錐體體積。"
    ],
    [
      "B",
      "底面積。"
    ],
    [
      "h",
      "頂點到底面平面的垂直高。"
    ]
  ],
  "conceptNarrative": [
    "錐體由底面向頂點逐漸縮小，不能像柱體每一層都保持同樣面積，因此體積小於Bh。",
    "在國中範圍可用實驗或分割理解：三個同底等高錐體的體積合起來等於一個柱體，故V=Bh/3。",
    "角錐的B是多邊形底面積；圓錐的B是πr²，所以圓錐V=πr²h/3。",
    "公式中的h一定是垂直高；斜高或母線需先由題目關係求出垂直高，不能直接代入。"
  ],
  "formalDefinitions": [
    [
      "錐體體積",
      "V=Bh/3。"
    ],
    [
      "圓錐體積",
      "V=πr²h/3。"
    ],
    [
      "同底等高比較",
      "錐體體積是柱體體積的1/3。"
    ]
  ],
  "formulas": [
    [
      "V=Bh/3",
      [
        "角錐或圓錐",
        "h為垂直高"
      ],
      "底面積乘高後除以3。"
    ],
    [
      "V圓錐=πr²h/3",
      [
        "r為底面半徑"
      ],
      "圓底面積代入通式。"
    ]
  ],
  "nonApplicableCases": [
    "不能漏除以3。",
    "不能把母線當圓錐高。",
    "不能用底面周長代替底面積。",
    "截去頂端後的錐臺不直接套單一錐體公式。"
  ],
  "method": [
    [
      "辨認底面並求B",
      "底面形狀與尺寸為何？"
    ],
    [
      "找垂直高h",
      "是否給的是母線或斜高？"
    ],
    [
      "先算Bh",
      "相當於同底等高柱體體積。"
