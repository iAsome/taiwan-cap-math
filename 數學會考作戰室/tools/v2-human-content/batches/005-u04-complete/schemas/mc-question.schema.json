{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "questionId",
    "unitId",
    "topicId",
    "skillId",
    "difficulty",
    "choices",
    "answerIndex",
    "independentSolution",
    "optionAnalysis",
    "contentAuthority",
    "contentSha256"
  ],
  "properties": {
    "contentAuthority": {
      "const": "CHATGPT_HUMAN_AUTHORED_R1"
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true,
  "title": "U04 human-authored multiple-choice record"
}
