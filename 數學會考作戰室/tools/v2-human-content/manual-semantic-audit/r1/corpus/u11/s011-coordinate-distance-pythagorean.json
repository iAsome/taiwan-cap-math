        "check": "符號平方後消失。"
      },
      {
        "step": 4,
        "instruction": "開正平方根。",
        "check": "距離非負。"
      },
      {
        "step": 5,
        "instruction": "套用坐標尺度。",
        "check": "轉成實際單位與精度。"
      }
