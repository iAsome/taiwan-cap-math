    "glossary": [
      {
        "term": "餘事",
        "definition": "事件A不發生的所有結果，記作A的餘事。"
      },
      {
        "term": "至少一次",
        "definition": "一次以上，餘事通常是零次。"
      },
      {
        "term": "互斥且完備",
        "definition": "A與其餘事不能同時發生且合起來是全部結果。"
      }
    ],
    "notation": [
      {
        "symbol": "P(A的餘事)=1-P(A)",
        "meaning": "餘事公式。"
      },
      {
        "symbol": "P(A)+P(A的餘事)=1",
        "meaning": "總機率。"
      }
    ],
    "conceptNarrative": [
      "餘事不是任意另一事件，而是「除了A以外的全部」。",
      "「至少一次成功」的餘事是「一次都沒成功」，通常比直接列所有成功情況簡單。",
      "二分類情境中合格與不合格可互為餘事，但若還有待判定類別，就不能直接相減。",
      "重複獨立試驗時，先算全部失敗路徑再用1減。",
      "機率20%不表示每5次固定一次，也不表示久未發生後下一次必發生。"
    ],
    "formalDefinitions": [
      {
        "name": "餘事事件",
        "statement": "S中不屬於A的結果。"
      },
      {
        "name": "至少一次公式",
        "statement": "1-P(零次)，需先正確計算零次。"
      }
    ],
    "formulas": [
      {
        "formula": "P(至少一次)=1-P(零次)",
        "conditions": [
          "重複試驗。"
        ],
        "meaning": "重複試驗。"
      },
      {
        "formula": "P(兩次都不發生)=q×q",
        "conditions": [
          "兩次獨立且每次不發生率q。"
        ],
        "meaning": "兩次獨立且每次不發生率q。"
      }
    ],
    "nonApplicableCases": [
      "分類未涵蓋全部時不可當餘事。",
      "至少一次不能只算恰好一次。",
      "獨立性未給定時不能直接相乘。",
      "連續未發生不改變固定獨立試驗下一次機率。"
    ],
    "method": [
      {
        "step": 1,
        "instruction": "寫出原事件",
        "check": "用精確語句。"
      },
      {
