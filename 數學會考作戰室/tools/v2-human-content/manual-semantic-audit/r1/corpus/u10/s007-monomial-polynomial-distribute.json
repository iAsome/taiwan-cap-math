    "notation": [
      {
        "symbol": "−2x(3x²−x+4)",
        "meaning": "−2x 分別乘 3x²、−x、4。"
      }
    ],
    "conceptNarrative": [
      "括號表示整個多項式都乘同一個單項式。",
      "每一項連同自己的符號一起相乘。",
      "展開後若出現同類項，再做合併。",
      "可用項數檢查：沒有抵消前，n 項通常會產生 n 個乘積項。"
    ],
    "formalDefinitions": [
      {
        "name": "單項式對多項式的分配",
        "statement": "m(A+B+…)=mA+mB+…。"
      }
    ],
    "formulas": [
      {
        "formula": "axᵐ(bxⁿ+c)=abxᵐ⁺ⁿ+ac",
        "conditions": [
          "所有括號內項都乘 axᵐ"
        ],
        "meaning": "分配律與指數律合用。"
      }
    ],
    "nonApplicableCases": [
      "不能只乘第一項。",
      "括號內負號不能忽略。",
      "分配後不同次方不能任意合併。",
      "若外因數為 0，整式結果為 0。"
    ],
