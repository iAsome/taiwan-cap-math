    "reviewStatus": "centrally-reviewed-semantic-audit-r1",
    "learningOutcomes": [
      "能辨認正整數、0、負整數與整數。",
      "能分辨整數和不是整數的分數或有限小數。",
      "知道每一個整數都可以寫成分母為 1 的分數，因此整數也是有理數。",
      "能把有限小數改寫成分數並約分。"
    ],
    "prerequisites": [],
    "glossary": [
      {
        "term": "正整數",
        "definition": "1、2、3、……這些大於 0 且沒有小數或分數部分的數。"
      },
      {
        "term": "負整數",
        "definition": "−1、−2、−3、……這些小於 0 且沒有小數或分數部分的數。"
      },
      {
        "term": "整數",
        "definition": "正整數、0 和負整數合在一起，稱為整數。"
      },
      {
        "term": "有限小數",
        "definition": "小數點後只有有限個數字的小數，例如 0.25、−1.4。"
      },
      {
        "term": "有理數",
        "definition": "可以寫成兩個整數相除的數，而且除數不能是 0。整數、分數與有限小數都是有理數。"
      }
    ],
    "notation": [
      {
        "symbol": "[[frac:a|b]]",
        "meaning": "表示 a 除以 b；b 不能是 0。"
      },
      {
        "symbol": "−",
        "meaning": "負號，表示這個數小於 0。"
      },
      {
        "symbol": "0",
        "meaning": "0 是整數，但不是正數，也不是負數。"
      }
    ],
    "conceptNarrative": [
      "先判斷一個數有沒有非零的小數或分數部分。沒有的話，它可能是整數。",
      "正負號不決定一個數是不是整數；−8 仍然是整數。",
      "分數有時可以化成整數，例如 [[frac:12|4]]=3。",
      "有限小數可以改寫成分母為 10、100、1000 等的分數，所以它們是有理數。",
      "本課只處理整數、分數與有限小數；其他數類留到後面的單元。"
    ],
    "formalDefinitions": [
      {
        "name": "整數",
        "statement": "整數包括正整數、0 和負整數。"
      },
      {
        "name": "有理數",
        "statement": "若一個數可以寫成 [[frac:a|b]]，其中 a、b 都是整數且 b≠0，這個數就是有理數。"
      },
      {
        "name": "整數與有理數的關係",
        "statement": "每個整數 n 都可以寫成 [[frac:n|1]]，所以每個整數都是有理數。"
      }
    ],
