    "formulas": [
      {
        "formula": "整數 n=[[frac:n|1]]",
        "conditions": [
          "n 是整數"
        ],
        "meaning": "把整數寫成分母為 1 的分數，說明整數也是有理數。"
      },
      {
        "formula": "有限小數＝整數÷10 的次方",
        "conditions": [
          "小數點後有有限位數"
        ],
        "meaning": "例如 0.35=[[frac:35|100]]=[[frac:7|20]]。"
      }
    ],
    "nonApplicableCases": [
