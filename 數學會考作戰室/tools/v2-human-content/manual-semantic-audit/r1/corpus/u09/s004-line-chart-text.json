    "vocabulary": [
      {
        "term": "資料點",
        "meaning": "一個橫軸位置與縱軸數值組成的點。"
      },
      {
        "term": "相鄰變化",
        "meaning": "後一點減前一點。"
      },
      {
        "term": "平均變化率",
        "meaning": "縱向改變除以橫向經過量。"
      },
      {
        "term": "組中點",
        "meaning": "組下限與上限的平均，作為次數分配折線圖橫座標。"
      },
      {
        "term": "水平線段",
        "meaning": "相鄰兩點數值相同。"
      }
