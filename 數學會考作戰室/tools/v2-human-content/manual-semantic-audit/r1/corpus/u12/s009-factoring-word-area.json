    "formalDefinitions": [
      {
        "name": "面積式因式分解",
        "statement": "將面積多項式分解為可作為長與寬的因式，並檢查其正值條件。"
      }
    ],
    "formulas": [
      {
        "formula": "A=L×W",
        "conditions": [
