    "workedExamples": [
      {
        "exampleId": "L1",
        "prompt": "兩區面積 8x^2 與 12x，共同高 4x",
        "solutionSteps": [
          "8x^2÷4x=2x。",
          "12x÷4x=3。"
        ],
        "answer": "總寬 2x+3"
      },
      {
        "exampleId": "L2",
        "prompt": "面積 x^2+7x+10",
        "solutionSteps": [
          "5·2=10，5+2=7。"
        ],
        "answer": "邊長可為 x+5 與 x+2"
      },
      {
        "exampleId": "L3",
        "prompt": "面積 6x^2+13x+6",
        "solutionSteps": [
          "交叉和 9x+4x=13x。"
        ],
        "answer": "邊長可為 3x+2 與 2x+3"
      },
      {
        "exampleId": "L4",
        "prompt": "面積 2x^2-8 且一邊為 2(x-2)",
        "solutionSteps": [
          "2x^2-8=2(x-2)(x+2)。",
          "需 x>2 才使已知邊長為正。"
        ],
        "answer": "另一邊為 x+2"
      }
    ],
