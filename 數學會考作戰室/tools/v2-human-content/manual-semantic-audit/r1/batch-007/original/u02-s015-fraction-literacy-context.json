      },
      {
        "step": 3,
        "instruction": "逐步列式並寫單位。",
        "check": "乘、除、加、減的理由？"
      },
      {
        "step": 4,
        "instruction": "檢查中間量範圍。",
        "check": "比例是否在合理區間？"
      },
      {
        "step": 5,
        "instruction": "比較或代回。",
        "check": "最終答案是否回應問句？"
      }
    ],
