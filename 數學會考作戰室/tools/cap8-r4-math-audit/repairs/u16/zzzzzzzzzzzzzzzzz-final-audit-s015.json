            "exampleId": "L1",
            "prompt": "沿凸八邊形邊界同方向走一周，每個頂點各記一次外角，總和是多少？",
            "solutionSteps": [
              "每個外角代表行進方向的一次轉變。",
              "走完封閉邊界並回到原方向，總轉向是一整圈。",
              "一整圈的角度為360°，不需依八個頂點平均。"
            ],
            "answer": "八個同方向外角的總和為360°。",
            "why": "外角和描述整條封閉路徑的累積轉向，並不是內角和；只要每頂點取一次且方向一致，邊數不改變總轉向。"
          },
          {
            "exampleId": "L2",
            "prompt": "求正十邊形的一個外角與一個內角。",
            "solutionSteps": [
              "十個相等外角合計360°，所以每個外角為36°。",
              "同頂點內角與外角互補。",
              "內角為180°-36°=144°。"
            ],
            "answer": "外角36°，內角144°。",
            "why": "正多邊形才可把固定的360°平均分配；算出外角後，再利用鄰補關係得到相鄰內角。"
          },
          {
            "exampleId": "L3",
            "prompt": "正多邊形的每個外角為45°，判斷邊數並檢查資料是否可行。",
            "solutionSteps": [
              "設邊數為n，列45n=360。",
              "解得n=8。",
              "8是大於等於3的整數，且8×45°=360°。"
            ],
            "answer": "此圖形是正八邊形。",
            "why": "相等外角把一整圈分成等份，商必須是合法整數邊數；本題整除，因此資料相容。"
          },
          {
            "exampleId": "L4",
            "prompt": "某凸六邊形前五個同方向外角為48°、72°、55°、63°、67°，求最後一個。",
            "solutionSteps": [
              "前五角和為48°+72°+55°+63°+67°=305°。",
              "由外角和360°，最後一角為360°-305°=55°。",
              "55°介於0°與180°之間，符合凸角範圍。"
            ],
            "answer": "第六個外角為55°。",
            "why": "非正多邊形的各外角不必相等，但同方向外角總和仍固定；因此應補足總和而不是取平均。"
          },
          {
            "exampleId": "L5",
            "prompt": "正多邊形每個內角為165°，求它的邊數。",
            "solutionSteps": [
              "相鄰外角為180°-165°=15°。",
              "邊數為360°÷15°=24。",
              "24個15°外角合計360°，驗算成立。"
            ],
            "answer": "此圖形是正二十四邊形。",
            "why": "邊數公式使用的是外角而不是內角；先轉成15°外角後，才能用一整圈360°計算等份數。"
          }
        ]
      }
