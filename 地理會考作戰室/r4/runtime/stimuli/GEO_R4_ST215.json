    "title": "醫療耗材供應中斷時間線",
    "prompt": "每日需求固定一百箱；可用庫存不含安全保留量。替代來源啟用後每日可供應六十箱。",
    "table": {
      "columns": [
        "日次",
        "事件或狀態",
        "主要來源供應",
        "可用庫存"
      ],
      "rows": [
        [
          "第0日",
          "港口設備故障",
          "每日0箱",
          "500箱"
        ],
        [
          "第3日",
          "替代來源完成品質審查",
          "仍為0箱",
          "200箱"
        ],
        [
          "第4日",
          "替代來源開始交貨",
          "每日60箱",
          "100箱"
        ],
        [
          "第8日",
          "港口設備修復",
          "積壓待清",
          "0箱"
        ],
        [
          "第10日",
          "主要來源恢復每日100箱",
          "每日100箱",
          "0箱"
