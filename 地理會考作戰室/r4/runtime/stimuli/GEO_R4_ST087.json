      "rows": [
        [
          "甲地來源區",
          "1980",
          "當地家庭日常製作",
          "米漿薄皮，包蔬菜後蒸熟"
        ],
        [
          "乙地港市",
          "1992",
          "甲地移民店家在港區開業",
          "米漿薄皮與蒸煮方式大致保留"
        ],
        [
          "丙地內陸城",
          "2001",
          "乙地至丙地鐵路通車後店家增加",
