  "content": {
    "title": "四段海岸觀測",
    "prompt": "沿岸漂砂長期主要由北向南，觀測涵蓋同一季節的五年變化。",
    "table": {
      "columns": [
        "岸段",
        "材質與形態",
        "五年變化"
      ],
      "rows": [
        [
          "甲",
          "節理岩岸；海蝕洞與崖",
          "崖線後退"
        ],
        [
          "乙",
          "港口北側沙灘",
          "寬度增加20公尺"
        ],
        [
          "丙",
          "港口南側沙灘",
          "寬度減少25公尺"
        ],
        [
          "丁",
          "沙洲內側淺水域",
          "潮口變窄、內側淤積"
        ]
