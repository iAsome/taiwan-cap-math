  "answerIndex": 1,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": false,
      "reason": "海底岩石不記錄大氣到陸地的水移動。「只記錄海底岩石種類」把題目未提供的條件也當成事實，不能由現有紀錄推出。"
    },
    {
      "optionIndex": 1,
