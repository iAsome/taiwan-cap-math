{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAP R4 lecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "unitId",
    "skillId",
    "authorityRefs",
    "prerequisites",
    "objectives",
    "sections",
    "workedExamples",
    "misconceptions",
    "checks",
    "assets",
    "finalAudit"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "subject": {
      "type": "string"
    },
    "unitId": {
      "type": "string"
    },
    "skillId": {
      "type": "string"
    },
    "authorityRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object"
      }
    },
    "workedExamples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object"
      }
    },
    "misconceptions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finalAudit": {
      "$ref": "final-exhaustive-audit-record-r4.schema.json"
    }
  }
}
