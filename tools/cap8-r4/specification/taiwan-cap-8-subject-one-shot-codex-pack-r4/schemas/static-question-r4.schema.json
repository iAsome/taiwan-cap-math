{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAP R4 static question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "skillIds",
    "authorityRefs",
    "stem",
    "options",
    "answerIndex",
    "correctRationale",
    "distractorRationales",
    "difficulty",
    "cognitiveProcess",
    "misconceptionTargets",
    "provenance",
    "finalAudit"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "subject": {
      "type": "string"
    },
    "skillIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "authorityRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "stimulusId": {
      "type": [
        "string",
        "null"
      ]
    },
    "stem": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "answerIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "correctRationale": {
      "type": "string",
      "minLength": 1
    },
    "distractorRationales": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "difficulty": {
      "enum": [
        "foundation",
        "standard",
        "advanced",
        "transfer"
      ]
    },
    "cognitiveProcess": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "misconceptionTargets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finalAudit": {
      "$ref": "final-exhaustive-audit-record-r4.schema.json"
    }
  }
}
