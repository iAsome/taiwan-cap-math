{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iasome.github.io/taiwan-cap-math/schemas/cap8-r4-authoring-contract.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "subject": {
      "enum": [
        "english",
        "chinese",
        "geography",
        "history",
        "civics",
        "biology",
        "physics_chemistry",
        "earth_science",
        "integrated_social",
        "integrated_natural"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "authority", "role", "retrievedAt", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "url": { "type": "string", "format": "uri" },
        "authority": { "type": "string", "minLength": 1 },
        "role": { "enum": ["binding-scope", "assessment-calibration", "binding-fact", "secondary-reference"] },
        "retrievedAt": { "type": "string", "minLength": 10 },
        "status": { "enum": ["verified", "unavailable-accounted"] },
        "sha256": { "$ref": "#/$defs/hash" },
        "repositoryPath": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "kind", "code", "text", "sourceIds", "applicable"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/subject" },
        "kind": { "enum": ["learning-performance", "learning-content", "appendix", "issue", "inquiry", "assessment-specification"] },
        "code": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "parentIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "applicable": { "type": "boolean" },
        "exclusionReason": { "type": "string" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "unitId", "title", "authorityRefs", "prerequisites"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/subject" },
        "unitId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "authorityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "prerequisites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "diagnosticQuestionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "remediationSkillIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "lecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "unitId", "skillId", "authorityRefs", "prerequisites", "objectives", "sections", "workedExamples", "misconceptions", "checks", "assets", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/subject" },
        "unitId": { "$ref": "#/$defs/id" },
        "skillId": { "$ref": "#/$defs/id" },
        "authorityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "prerequisites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sections": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "content"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "minLength": 1 },
              "content": { "type": "string", "minLength": 1 }
            }
          }
        },
        "workedExamples": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "prompt", "steps", "answer", "why"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "prompt": { "type": "string", "minLength": 1 },
              "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "answer": { "type": "string", "minLength": 1 },
              "why": { "type": "string", "minLength": 1 }
            }
          }
        },
        "misconceptions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["belief", "whyWrong", "correction"],
            "properties": {
              "belief": { "type": "string", "minLength": 1 },
              "whyWrong": { "type": "string", "minLength": 1 },
              "correction": { "type": "string", "minLength": 1 }
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "answer", "reason"],
            "properties": {
              "prompt": { "type": "string", "minLength": 1 },
              "answer": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "optionRationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionIndex", "isCorrect", "reason"],
      "properties": {
        "optionIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
        "isCorrect": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "skillIds", "authorityRefs", "stem", "options", "answerIndex", "optionRationales", "difficulty", "cognitiveProcess", "representationType", "misconceptionTargets", "provenance", "assets"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/subject" },
        "skillIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "authorityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "stimulusId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "stem": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 3, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "answerIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
        "optionRationales": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "$ref": "#/$defs/optionRationale" } },
        "difficulty": { "enum": ["foundation", "standard", "advanced", "transfer"] },
        "cognitiveProcess": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "representationType": { "type": "string", "minLength": 1 },
        "misconceptionTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "independentReviews": {
          "type": "array",
          "deprecated": true,
          "description": "Legacy compatibility payload only; external final-audit evidence determines acceptance."
        },
        "assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authorRole", "copyrightStatus", "sourceRefs"],
      "properties": {
        "status": { "enum": ["original", "public-domain", "licensed", "official-reference-only"] },
        "authorRole": { "type": "string", "minLength": 1 },
        "copyrightStatus": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "dataFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "columns", "rows"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "skillIds", "type", "path", "sha256", "creator", "source", "license", "originality", "transformationRecord", "calibrationRefs", "caption", "altText", "longDescription", "accessibility", "technical"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/subject" },
        "skillIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "type": { "enum": ["figure", "map", "graph", "table", "science-diagram", "audio"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "creator": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "originality": { "enum": ["original", "public-domain", "licensed"] },
        "transformationRecord": { "type": "string", "minLength": 1 },
        "calibrationRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "caption": { "type": "string", "minLength": 1 },
        "altText": { "type": "string", "minLength": 1 },
        "longDescription": { "type": "string", "minLength": 20 },
        "dataFallback": { "$ref": "#/$defs/dataFallback" },
        "transcript": { "type": "string", "minLength": 1 },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colorIndependent", "printSafe"],
          "properties": {
            "colorIndependent": { "const": true },
            "printSafe": { "const": true }
          }
        },
        "technical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drawingMode": { "enum": ["schematic", "to-scale"] },
            "labels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "units": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "scale": { "type": "string", "minLength": 1 },
            "orientation": { "type": "string", "minLength": 1 },
            "legend": { "type": "string", "minLength": 1 },
            "projection": { "type": "string", "minLength": 1 },
            "mapContext": { "enum": ["contemporary", "historical", "data"] },
            "dateOrYear": { "type": "string", "minLength": 1 },
            "uncertaintyNote": { "type": "string", "minLength": 1 },
            "dataSource": { "type": "string", "minLength": 1 },
            "axes": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
            "significantFigures": { "type": "string", "minLength": 1 },
            "controlledVariables": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "headers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "scriptSha256": { "$ref": "#/$defs/hash" },
            "voice": { "type": "string", "minLength": 1 },
            "rate": { "type": "string", "minLength": 1 },
            "pausePattern": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "audio" } }, "required": ["type"] },
          "then": {
            "required": ["transcript"],
            "properties": { "technical": { "type": "object", "required": ["scriptSha256", "voice", "rate", "pausePattern"] } }
          },
          "else": { "required": ["dataFallback"] }
        },
        {
          "if": { "properties": { "type": { "const": "map" } }, "required": ["type"] },
          "then": { "properties": { "technical": { "type": "object", "required": ["scale", "orientation", "legend", "projection", "mapContext"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "graph" } }, "required": ["type"] },
          "then": { "properties": { "technical": { "type": "object", "required": ["axes", "units", "legend", "significantFigures", "controlledVariables", "dataSource"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "table" } }, "required": ["type"] },
          "then": { "properties": { "technical": { "type": "object", "required": ["headers", "units", "dataSource"] } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["figure", "science-diagram"] } }, "required": ["type"] },
          "then": { "properties": { "technical": { "type": "object", "required": ["drawingMode", "labels"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "science-diagram" } }, "required": ["type"] },
          "then": { "properties": { "technical": { "type": "object", "required": ["units", "controlledVariables"] } } }
        }
      ]
    },
    "finalAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactType", "artifactSha256", "status", "reviewerRole", "reviewedAt", "fullRead", "renderedContextInspected", "independentSolveOrEvidenceCheck", "allFindingsResolved", "findings", "auditRecordSha256"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "artifactType": { "enum": ["lecture", "question", "stimulus", "asset", "writing-task", "ui"] },
        "artifactSha256": { "$ref": "#/$defs/hash" },
        "status": { "const": "accepted" },
        "reviewerRole": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "minLength": 10 },
        "fullRead": { "const": true },
        "renderedContextInspected": { "const": true },
        "independentSolveOrEvidenceCheck": { "const": true },
        "allFindingsResolved": { "const": true },
        "findings": { "type": "array", "items": { "type": "string" } },
        "auditRecordSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "corpusRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "startByte", "endByte", "artifactSha256", "auditRecordSha256"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 1 },
        "artifactSha256": { "$ref": "#/$defs/hash" },
        "auditRecordSha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
