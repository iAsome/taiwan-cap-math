  "stem": "Why is 'between you and I' corrected to 'between you and me'?",
  "options": [
    "I can never follow and.",
    "You changes into your.",
    "Between takes object pronouns.",
    "Me is always more formal."
  ],
  "answerIndex": 2,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": false,
      "reason": "I can never follow and.：I 可在主詞並列中跟在 and 後。"
    },
    {
      "optionIndex": 1,
      "isCorrect": false,
      "reason": "You changes into your.：you 在此不需改。"
    },
    {
      "optionIndex": 2,
      "isCorrect": true,
      "reason": "Between takes object pronouns.：介系詞 between 後用受格。"
    },
    {
      "optionIndex": 3,
      "isCorrect": false,
      "reason": "Me is always more formal.：正式度不是格位規則。"
    }
  ],
