  "stem": "A school gave each team a box. The teams painted them, filled them with books, and sent them away. What does every them refer to?",
  "options": [
    "the teams",
    "the boxes",
    "the books",
    "the schools"
  ],
  "answerIndex": 1,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": false,
      "reason": "the teams：teams 是動作執行者，不是受詞。"
    },
    {
      "optionIndex": 1,
      "isCorrect": true,
      "reason": "the boxes：paint、fill 與 send 的共同受詞都是複數 boxes。"
    },
    {
      "optionIndex": 2,
      "isCorrect": false,
      "reason": "the books：books 到 filled 之後才出現，不能回指第一個 them。"
    },
    {
      "optionIndex": 3,
      "isCorrect": false,
      "reason": "the schools：只有一所 school，且不是這三個動作的受詞。"
    }
  ],
