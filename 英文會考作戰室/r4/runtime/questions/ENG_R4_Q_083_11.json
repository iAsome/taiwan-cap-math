  "stem": "A club card says, “Member from September 1.” Today is December 1. Which sentence says she is still a member?",
  "options": [
    "She was a member tomorrow.",
    "She is a member for September 1.",
    "She has been a member since September 1.",
    "She has been a member ago September 1."
  ],
  "answerIndex": 2,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": false,
      "reason": "was tomorrow 混用過去與未來。"
    },
    {
      "optionIndex": 1,
      "isCorrect": false,
      "reason": "for 不能接 September 1 這個起點。"
    },
    {
      "optionIndex": 2,
      "isCorrect": true,
      "reason": "has been...since 表示會員身分從該日起持續。"
    },
    {
      "optionIndex": 3,
      "isCorrect": false,
      "reason": "ago 不能放在日期前形成此完成式。"
