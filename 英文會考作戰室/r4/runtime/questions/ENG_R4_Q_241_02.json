  "stem": "The river was once dirty. Volunteers cleaned the water, and the stream now has fish again. Which words form a topic chain?",
  "options": [
    "river-water-stream",
    "dirty-volunteers-fish",
    "once-now-again",
    "cleaned-has"
  ],
  "answerIndex": 0,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": true,
      "reason": "river-water-stream：river、water、stream 在此共同承接同一水域。"
    },
    {
      "optionIndex": 1,
      "isCorrect": false,
      "reason": "dirty-volunteers-fish：三字分屬狀態、人物與動物，不能命名同一對象。"
    },
