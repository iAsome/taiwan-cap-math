  "stem": "The sentence is 'I am early.' Which question asks the speaker about it?",
  "options": [
    "Are you early?",
    "Am I early?",
    "Do you are early?",
    "Is you early?"
  ],
  "answerIndex": 0,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": true,
      "reason": "Are you early?：對聽者提問時 I 轉為 you，am 轉為 are。"
    },
    {
      "optionIndex": 1,
      "isCorrect": false,
      "reason": "Am I early?：這是說話者問自己的形式。"
    },
    {
