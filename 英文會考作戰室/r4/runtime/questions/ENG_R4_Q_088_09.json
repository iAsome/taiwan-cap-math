  "stem": "Which question matches “She has to finish by Friday”?",
  "options": [
    "Has she to finish by Friday?",
    "Does she has to finish by Friday?",
    "Is she have to finish by Friday?",
    "Does she have to finish by Friday?"
  ],
  "answerIndex": 3,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": false,
      "reason": "一般現代英文不以 Has she to...? 作本題目標問法。"
    },
    {
      "optionIndex": 1,
      "isCorrect": false,
      "reason": "Does 已承擔第三人稱標記，後面不能再寫 has。"
    },
    {
      "optionIndex": 2,
      "isCorrect": false,
      "reason": "Is 不能接 have to 形成此問句。"
    },
    {
      "optionIndex": 3,
      "isCorrect": true,
      "reason": "Does she have to...? 正確把陳述句改成問句。"
    }
  ],
