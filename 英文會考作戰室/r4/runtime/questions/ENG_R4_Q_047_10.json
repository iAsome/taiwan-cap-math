  "stem": "Whose lunch is missing? The lunch belongs to Mina. Which reply avoids repetition?",
  "options": [
    "Her is missing.",
    "Mina's hers is missing.",
    "She missing lunch's.",
    "Hers is missing."
  ],
  "answerIndex": 3,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": false,
      "reason": "Her is missing.：her 後缺名詞。"
    },
    {
      "optionIndex": 1,
      "isCorrect": false,
      "reason": "Mina's hers is missing.：所有形式重複。"
    },
    {
      "optionIndex": 2,
      "isCorrect": false,
      "reason": "She missing lunch's.：主詞、動詞與所有格皆錯。"
    },
    {
      "optionIndex": 3,
      "isCorrect": true,
      "reason": "Hers is missing.：hers 獨立代替 Mina's lunch。"
    }
