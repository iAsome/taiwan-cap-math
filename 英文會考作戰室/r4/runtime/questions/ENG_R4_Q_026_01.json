  "stem": "___ will lead the tour. Choose between 'He' and 'Him'.",
  "options": [
    "He",
    "Him",
    "His",
    "Himself's"
  ],
  "answerIndex": 0,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": true,
      "reason": "He：空格是 will lead 的主詞，使用主格。"
    },
    {
      "optionIndex": 1,
      "isCorrect": false,
      "reason": "Him：受格不能作此句主詞。"
    },
    {
      "optionIndex": 2,
      "isCorrect": false,
      "reason": "His：所有格需要搭配名詞或作所有代名詞另有形式。"
    },
    {
      "optionIndex": 3,
      "isCorrect": false,
      "reason": "Himself's：反身與所有格結構皆不合。"
    }
  ],
