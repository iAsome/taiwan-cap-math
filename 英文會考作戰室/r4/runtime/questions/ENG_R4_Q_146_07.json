  "stem": "A student writes, 'I will call when I will arrive.' Which change fixes the time words?",
  "options": [
    "I → Me",
    "call → called",
    "will arrive → arrive",
    "when → because"
  ],
  "answerIndex": 2,
  "optionRationales": [
