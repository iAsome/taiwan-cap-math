  "objectives": [
    "辨認對話中的問題焦點。",
    "抓取更正後的關鍵細節。",
    "區分提議與最後資訊。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U48_ENG_R4_S316_SEC_1",
      "title": "先分說話者",
      "content": "A 提問、B 回答時，不把 B 的物品當 A 的。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S316_SEC_2",
      "title": "更正詞優先",
      "content": "not Tuesday—Wednesday、actually Room 3 會取代先前猜測。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S316_SEC_3",
      "title": "問題決定要記什麼",
      "content": "若問 where，只記地點；其餘價格或感受是干擾。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S316_SEC_4",
      "title": "最後確認覆蓋提議",
      "content": "Maybe 3:00 是提議；Let's make it 3:30 是決定。"
    }
  ],
