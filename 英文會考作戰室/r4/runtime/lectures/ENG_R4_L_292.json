    "ENG_R4_S291"
  ],
  "objectives": [
    "由 wants、needs 與行動辨認人物目標。",
    "追蹤每一步是否服務同一目標。",
    "以反應判斷目標達成或受阻。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U44_ENG_R4_S292_SEC_1",
      "title": "先寫人物要什麼",
      "content": "把 wants to catch the bus 改寫成 goal: catch bus。後續細節都問是否幫助此目標。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S292_SEC_2",
      "title": "策略可以變，目標不一定變",
      "content": "改走另一條路可能只是換方法；只有人物明確放棄或選新目標才算目標改變。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S292_SEC_3",
      "title": "反應揭示進度",
      "content": "smiled after the door opened 支持成功；kept searching 顯示尚未達成。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S292_SEC_4",
      "title": "不要把旁人目標混入",
      "content": "對話有多人時，追蹤題目指定人物的 need、decision 與 action。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U44_ENG_R4_S292_EX_1",
      "prompt": "Ben wanted a quiet desk. Room A was noisy, so he tried Room B.",
      "steps": [
        "目標 quiet desk。",
        "離開 A 是策略。",
        "去 B 仍服務原目標。"
      ],
      "answer": "His goal stays the same.",
      "why": "只有方法改變。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S292_EX_2",
      "prompt": "Mia looked for her key and cheered when it fell from her bag.",
      "steps": [
        "目標 find key。",
        "key 出現。",
        "cheered 驗證成功。"
      ],
      "answer": "She finds the key.",
      "why": "事件與反應一致。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S292_EX_3",
      "prompt": "Leo planned to swim, but the pool closed, so he chose to study instead.",
      "steps": [
        "原目標 swim。",
        "closure 阻止。",
        "chooses study 明示新目標。"
      ],
      "answer": "His goal changes.",
      "why": "不是單純換游泳方式。"
    }
  ],
  "misconceptions": [
    {
      "belief": "每個動作都是新目標。",
      "whyWrong": "動作可能只是策略。",
      "correction": "問它服務什麼結果。"
    },
    {
      "belief": "遇到困難就等於放棄。",
      "whyWrong": "人物可能持續嘗試。",
      "correction": "找 kept、tried again。"
    },
    {
      "belief": "笑一定表示原目標達成。",
      "whyWrong": "需與事件連結。",
      "correction": "核對笑之前發生什麼。"
    },
    {
      "belief": "把幫助者的目標當主角目標。",
      "whyWrong": "角色不同。",
      "correction": "固定追蹤指定名字。"
    }
  ],
  "checks": [
    {
      "prompt": "換路但仍去同一地點，目標變了嗎？",
      "answer": "沒有",
      "reason": "只是策略變。"
    },
    {
      "prompt": "kept searching 表示什麼？",
      "answer": "目標尚未達成且持續",
      "reason": "行動仍指向原目標。"
    },
    {
      "prompt": "判斷成功需什麼？",
      "answer": "結果與人物反應",
      "reason": "兩者互相驗證。"
    }
  ],
