  "objectives": [
    "區分主題與過窄細節。",
    "利用重複概念找核心說明。",
    "選擇涵蓋全文但不超出範圍的主旨。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U45_ENG_R4_S297_SEC_1",
      "title": "主題先回答談什麼",
      "content": "找各句共同指向的名詞，例如 urban trees。單一例子如 one park 只是細節。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S297_SEC_2",
      "title": "核心概念再回答說什麼",
      "content": "文章可能說樹如何降溫、蜜蜂如何溝通。主旨需包含對象與主要說明。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S297_SEC_3",
      "title": "用涵蓋測試",
      "content": "把候選主旨套到每句；若只涵蓋一段就太窄，若加入文外政策就太廣。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S297_SEC_4",
      "title": "標題是線索不是答案",
      "content": "標題可能只給主題，仍需正文決定作者強調的關係。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U45_ENG_R4_S297_EX_1",
      "prompt": "Trees shade walls, cool streets, and reduce indoor heat.",
      "steps": [
        "重複 cool/heat。",
        "對象 trees。",
        "合成作用。"
      ],
      "answer": "Trees can reduce city heat.",
      "why": "涵蓋三項細節。"
    },
    {
