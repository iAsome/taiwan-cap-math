  "objectives": [
    "追蹤問題與候選方案。",
    "記錄方案被排除的原因。",
    "由同意語與最後確認判斷決定。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U48_ENG_R4_S320_SEC_1",
      "title": "建立方案表",
      "content": "每出現一個方案寫 A/B，旁邊記 cost、time、open 等限制。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S320_SEC_2",
      "title": "否定後劃掉",
      "content": "too late、full、can't 會排除前案，不能因先聽到而保留。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S320_SEC_3",
      "title": "同意語鎖定決定",
      "content": "That works、Let's do that、Good, I'll book it 表方案定案。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S320_SEC_4",
      "title": "問題與決定都要回答",
      "content": "問 why chose 時需說被選方案如何解決原問題，而非只報名稱。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U48_ENG_R4_S320_EX_1",
      "prompt": "A bus late; B train costs more; agree train",
      "steps": [
        "問題 time。",
        "bus 排除。",
        "接受 train。"
      ],
      "answer": "They choose train for time.",
      "why": "最後同意覆蓋早案。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S320_EX_2",
      "prompt": "Room A full; Room B at 4; That's fine",
      "steps": [
        "A 刪除。",
        "B 可行。",
        "同意詞鎖定。"
      ],
      "answer": "Room B at 4",
      "why": "條件完整。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S320_EX_3",
      "prompt": "Buy now? wait for sale? Need today",
      "steps": [
        "候選 wait。",
        "限制 need today。",
        "因此 buy now。"
      ],
      "answer": "buy now",
      "why": "用限制解決決策。"
    }
  ],
  "misconceptions": [
