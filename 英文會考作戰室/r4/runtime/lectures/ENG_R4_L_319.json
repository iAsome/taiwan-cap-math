  "objectives": [
    "辨認廣播對象與場所。",
    "抓取 must、do not、instead 等行動限制。",
    "區分原因與實際指示。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U48_ENG_R4_S319_SEC_1",
      "title": "先抓呼語",
      "content": "Passengers、visitors、students 指定誰需行動。不是所有聽者都同樣受影響。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S319_SEC_2",
      "title": "動詞是核心",
      "content": "leave、wait、use Gate B 是要做；do not enter 是禁止。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S319_SEC_3",
      "title": "更新詞取代舊路線",
      "content": "instead、now、has moved 代表新指示優先。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S319_SEC_4",
      "title": "原因不能取代行動",
      "content": "because of repairs 解釋原因，真正答案仍是 use east door。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U48_ENG_R4_S319_EX_1",
      "prompt": "Passengers for Bus 4, use Stop B.",
      "steps": [
        "對象 Bus 4。",
        "動作 use。",
        "地點 B。"
      ],
      "answer": "use Stop B",
      "why": "完整指示。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S319_EX_2",
      "prompt": "Do not enter; use side door instead.",
      "steps": [
        "禁止 front。",
        "instead 新方案。",
        "選 side door。"
      ],
      "answer": "use side door",
      "why": "不是只回答 repairs。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S319_EX_3",
      "prompt": "Due to rain, event moves inside.",
      "steps": [
        "原因 rain。",
        "變更 moves。",
        "行動 go inside。"
      ],
      "answer": "go indoors",
      "why": "原因與指示分開。"
    }
  ],
