  "objectives": [
    "用英語請求重說。",
    "請求放慢或解釋。",
    "依缺口選最精確句型。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U02_ENG_R4_S011_SEC_1",
      "title": "沒聽清請重說",
      "content": "Could you say that again? 針對聲音或遺漏。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S011_SEC_2",
      "title": "太快請放慢",
      "content": "Could you speak more slowly? 比 repeat 更精確。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S011_SEC_3",
      "title": "不懂詞請解釋",
      "content": "What does ___ mean? 問詞義；Could you give an example? 問具體例子。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S011_SEC_4",
      "title": "禮貌形式完整",
      "content": "Excuse me、please、could 降低命令感，但核心缺口仍需說清楚。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U02_ENG_R4_S011_EX_1",
      "prompt": "Missed the sentence",
      "steps": [
        "缺整句。",
        "選 say again。",
        "加 please。"
      ],
      "answer": "Could you say that again, please?",
      "why": "精確修復。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S011_EX_2",
