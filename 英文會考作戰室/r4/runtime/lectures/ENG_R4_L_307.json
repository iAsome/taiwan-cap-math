  "objectives": [
    "辨認兩來源各自強調的面向。",
    "以 while 比較觀點而不判輸贏。",
    "區分事實差異與解讀差異。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U46_ENG_R4_S307_SEC_1",
      "title": "固定同一事件",
      "content": "先確認兩來源都談同一 plan/event，再各寫 emphasis。"
    },
    {
      "id": "ENG_R4_U46_ENG_R4_S307_SEC_2",
      "title": "觀點從選材看出",
      "content": "商家強調 customers，居民強調 noise；不需猜作者個性。"
    },
    {
      "id": "ENG_R4_U46_ENG_R4_S307_SEC_3",
      "title": "共同事實不等於同觀點",
      "content": "兩者都承認 road closes，但一方重視 safety、一方重視 delay。"
    },
    {
      "id": "ENG_R4_U46_ENG_R4_S307_SEC_4",
      "title": "公平轉述",
      "content": "用 Source A emphasizes... while B worries...，不把不同意的一方改寫得極端。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U46_ENG_R4_S307_EX_1",
      "prompt": "A: park brings visitors. B: park removes parking",
      "steps": [
        "同一 park plan。",
        "A 強調 benefit。",
        "B 強調 cost。"
      ],
      "answer": "different priorities",
      "why": "不需選誰對。"
    },
    {
      "id": "ENG_R4_U46_ENG_R4_S307_EX_2",
      "prompt": "A/B both say Friday; differ on usefulness",
      "steps": [
        "日期共同事實。",
        "評價不同。",
        "分開處理。"
      ],
      "answer": "same fact, different judgment",
      "why": "不把日期當衝突。"
    },
    {
      "id": "ENG_R4_U46_ENG_R4_S307_EX_3",
      "prompt": "A: safe; B: slower",
      "steps": [
        "可同時為真。",
        "各選不同結果。",
        "比較 emphasis。"
      ],
      "answer": "safety versus convenience",
      "why": "不是直接事實矛盾。"
    }
  ],
  "misconceptions": [
    {
      "belief": "觀點不同代表一方說謊。",
      "whyWrong": "可能強調不同面向。",
      "correction": "先測能否同時為真。"
    },
    {
      "belief": "只轉述自己同意的來源。",
      "whyWrong": "題目要求比較。",
      "correction": "兩邊各一證據。"
    },
    {
      "belief": "共同日期表示觀點相同。",
      "whyWrong": "事實可同、評價可異。",
      "correction": "分 fact/judgment。"
    },
    {
      "belief": "把較弱語氣改成極端。",
      "whyWrong": "會失真。",
      "correction": "保留 may、concern 等強度。"
    }
  ],
  "checks": [
