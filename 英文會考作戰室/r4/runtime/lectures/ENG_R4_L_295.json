  ],
  "objectives": [
    "分別描述人物開頭與結尾狀態。",
    "使用 from...to 或 learns to 表達變化。",
    "區分真正改變與環境改變。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U44_ENG_R4_S295_SEC_1",
      "title": "建立前後兩格",
      "content": "開頭寫 attitude/action，結尾再寫同一面向。若面向不同，不能直接比較。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S295_SEC_2",
      "title": "找促成變化的經驗",
      "content": "人物可能因練習、錯誤或他人回饋而改變。原因要由故事明示。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S295_SEC_3",
      "title": "環境改變不等於人物改變",
      "content": "雨停了只改天氣；除非人物因此做出新選擇，不能說性格改變。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S295_SEC_4",
      "title": "強度要符合",
      "content": "一次願意發言可說 becomes more willing，不可說 will always love public speaking。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U44_ENG_R4_S295_EX_1",
      "prompt": "At first refused help; later asked a classmate",
      "steps": [
        "同面向：接受協助。",
        "開頭拒絕。",
        "結尾主動問。"
      ],
      "answer": "from refusing help to accepting it",
      "why": "前後直接對照。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S295_EX_2",
      "prompt": "Could not swim; practiced; crossed pool",
      "steps": [
        "同面向：能力。",
        "練習為原因。",
        "結尾能力提升。"
      ],
      "answer": "becomes able to swim across",
      "why": "不是說成天生會。"
    },
    {
      "id": "ENG_R4_U44_ENG_R4_S295_EX_3",
      "prompt": "Rainy morning; sunny evening; character same",
      "steps": [
        "只有天氣變。",
        "行動態度無對照。",
        "不宣稱人物成長。"
      ],
      "answer": "No character change is shown.",
      "why": "環境不是人格。"
    }
  ],
  "misconceptions": [
    {
      "belief": "時間過去就一定有人物成長。",
      "whyWrong": "可能只有事件推進。",
      "correction": "比較同一面向。"
    },
    {
      "belief": "環境變化就是角色變化。",
      "whyWrong": "天氣地點不等於態度。",
      "correction": "找角色行動。"
    },
    {
      "belief": "一次改變可推成永遠。",
      "whyWrong": "範圍過度。",
      "correction": "使用 more willing 等有限語氣。"
    },
    {
      "belief": "只描述結尾也算比較。",
      "whyWrong": "缺少起點。",
      "correction": "使用 from...to。"
    }
  ],
  "checks": [
    {
