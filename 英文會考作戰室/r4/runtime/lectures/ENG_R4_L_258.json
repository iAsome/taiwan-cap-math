  "objectives": [
    "為推論建立可追溯證據鏈。",
    "辨認選項新增的身份、動機、永久結果或絕對語氣。",
    "在證據不足時選擇保留不確定的說法。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U38_ENG_R4_S258_SEC_1",
      "title": "推論仍要有腳印",
      "content": "每一步都應能指出原文。若答案需要『也許他是醫生』這類新身份才能成立，就是猜測。"
    },
    {
      "id": "ENG_R4_U38_ENG_R4_S258_SEC_2",
      "title": "警覺故事性細節",
      "content": "選項常加 brother、last year、because he was angry 等生動內容。生動不等於有證據。"
    },
    {
      "id": "ENG_R4_U38_ENG_R4_S258_SEC_3",
      "title": "保留可能性語氣",
      "content": "likely、may、probably 常適合有限推論；must、always、never 需要極強文字。"
    },
    {
      "id": "ENG_R4_U38_ENG_R4_S258_SEC_4",
      "title": "問少了哪個前提",
      "content": "對每個選項問：要讓它成立，我還需假設什麼？正確推論需要的額外假設最少。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U38_ENG_R4_S258_EX_1",
      "prompt": "Wet umbrella + rain sound → probably raining.",
      "steps": [
        "兩項文本證據。",
        "結論一般。",
        "無需新身份。"
      ],
      "answer": "reasonable inference",
      "why": "不能加颱風名稱。"
    },
    {
      "id": "ENG_R4_U38_ENG_R4_S258_EX_2",
      "prompt": "A man wears a white coat → he is a doctor.",
      "steps": [
        "只有衣著。",
        "多職業可穿。",
        "需要新前提。"
      ],
      "answer": "unsupported guess",
      "why": "不能唯一判身份。"
    },
    {
      "id": "ENG_R4_U38_ENG_R4_S258_EX_3",
      "prompt": "No reply for one hour → she will never reply.",
      "steps": [
        "只有一小時。",
        "never 是永久。",
        "強度超出。"
      ],
      "answer": "unsupported",
      "why": "最多說尚未回。"
    }
  ],
  "misconceptions": [
