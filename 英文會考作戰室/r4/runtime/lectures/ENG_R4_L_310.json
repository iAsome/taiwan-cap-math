  "objectives": [
    "辨認動作核心。",
    "區分相似人物的不同進行狀態。",
    "用 be + V-ing 核對正在發生的動作。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U47_ENG_R4_S310_SEC_1",
      "title": "先抓動詞重音",
      "content": "walking、sitting、pointing、standing 是選圖關鍵。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S310_SEC_2",
      "title": "進行狀態不是習慣",
      "content": "is walking 表當下畫面，不等於每天走路。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S310_SEC_3",
      "title": "姿勢要完整",
      "content": "彎腿坐椅是 sitting；直立不移動是 standing。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S310_SEC_4",
      "title": "物件是第二線索",
      "content": "動作相同時再用物件確認。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U47_ENG_R4_S310_EX_1",
      "prompt": "They are walking.",
      "steps": [
        "抓 are。",
        "walking 進行。",
        "找多人步行。"
      ],
      "answer": "walking picture",
      "why": "人數再確認。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S310_EX_2",
      "prompt": "He is pointing.",
      "steps": [
        "pointing 非 holding。",
        "看伸臂方向。",
        "排 standing。"
      ],
      "answer": "pointing picture",
      "why": "動作形狀不同。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S310_EX_3",
      "prompt": "She is sitting.",
      "steps": [
        "找座椅與彎腿。",
        "排站立。",
        "再核物件。"
      ],
      "answer": "seated picture",
      "why": "姿勢是核心。"
    }
  ],
  "misconceptions": [
    {
      "belief": "人物直立都算 walking。",
      "whyWrong": "walking 有步態。",
      "correction": "看腿部方向。"
    },
    {
      "belief": "看到手臂就算 pointing。",
      "whyWrong": "站立也可能伸手。",
      "correction": "看明確水平指向。"
    },
    {
      "belief": "is walking 當未來。",
      "whyWrong": "此處描述畫面。",
      "correction": "依現在進行。"
    },
    {
      "belief": "只用物件不聽動作。",
      "whyWrong": "會選到錯姿勢。",
      "correction": "動作先行。"
    }
  ],
  "checks": [
