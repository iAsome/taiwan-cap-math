  "prerequisites": [
    "ENG_R4_S004"
  ],
  "objectives": [
    "辨認 CVC 與 CVCe 對比。",
    "理解 final e 的常見作用。",
    "以例字確認長母音與意思。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U01_ENG_R4_S005_SEC_1",
      "title": "末尾 e 常安靜",
      "content": "cap → cape 中 e 不另成音節，而使 a 讀常見長音 /eɪ/。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S005_SEC_2",
      "title": "先比較最小對",
      "content": "kit/kite、hop/hope 只加 e，母音與意思改變。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S005_SEC_3",
      "title": "子音仍保留",
      "content": "cube 的 c、b 仍需拼讀；不能只讀母音名稱。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S005_SEC_4",
      "title": "規則有範圍",
      "content": "have、give 等不是此規則的標準例。本技能使用明確常見 CVCe。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U01_ENG_R4_S005_EX_1",
      "prompt": "cap/cape",
      "steps": [
        "cap 短 a。",
        "加 final e。",
        "cape 長 a。"
      ],
      "answer": "cape /eɪ/",
      "why": "e 不另讀。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S005_EX_2",
      "prompt": "kit/kite",
      "steps": [
        "短 i /ɪ/。",
        "末 e。",
        "長 i /aɪ/。"
      ],
      "answer": "kite",
      "why": "意思也變。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S005_EX_3",
      "prompt": "hop/hope",
      "steps": [
        "短 o。",
        "加 e。",
        "長 o /oʊ/。"
      ],
      "answer": "hope",
      "why": "保留 h/p。"
    }
  ],
  "misconceptions": [
    {
      "belief": "final e 一定獨立念。",
      "whyWrong": "常為 silent。",
      "correction": "看 CVCe 整體。"
    },
    {
      "belief": "加 e 只改拼字不改音。",
      "whyWrong": "常改前母音。",
      "correction": "做最小對比較。"
    },
    {
      "belief": "所有 e 結尾字都同規則。",
      "whyWrong": "英文有例外。",
      "correction": "限明確例字。"
    },
    {
      "belief": "只念長母音，省略子音。",
      "whyWrong": "完整字仍含首尾音。",
      "correction": "滑讀全字。"
    }
  ],
  "checks": [
    {
      "prompt": "cape 最後 e 通常另成音嗎？",
      "answer": "不會",
      "reason": "它影響 a。"
    },
    {
      "prompt": "kit 加 e 形成？",
      "answer": "kite",
      "reason": "母音變長。"
    },
    {
      "prompt": "規則可套 have 嗎？",
      "answer": "不可直接套",
      "reason": "屬常見例外。"
    }
  ],
