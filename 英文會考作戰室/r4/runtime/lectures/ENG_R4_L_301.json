  "objectives": [
    "辨認相同與不同的比較結構。",
    "由共同特徵辨認分類。",
    "區分問題描述與解決方案。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U45_ENG_R4_S301_SEC_1",
      "title": "比較有兩個以上對象",
      "content": "both、unlike、while、however 會標出同異。只列一物特徵不是比較。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S301_SEC_2",
      "title": "分類依一項規則分組",
      "content": "animals are grouped by diet 需以 diet 一致分類；不可一組按顏色、一組按大小。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S301_SEC_3",
      "title": "問題解決有缺口與回應",
      "content": "先說 water was wasted，再說 sensor stopped the tap。解決必須回應同一問題。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S301_SEC_4",
      "title": "一篇可有主要結構",
      "content": "局部例子不改變全文主架構。選能解釋多數句子排列的結構。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U45_ENG_R4_S301_EX_1",
      "prompt": "Both frogs and fish live in water, but frogs breathe air",
      "steps": [
        "兩對象。",
        "both 相同。",
        "but 引差異。"
      ],
      "answer": "comparison",
      "why": "同異皆有。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S301_EX_2",
      "prompt": "Waste is sorted as paper, metal, or glass",
      "steps": [
        "共同規則 material。",
        "三類。",
        "不是時間順序。"
      ],
      "answer": "classification",
      "why": "按材質分組。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S301_EX_3",
      "prompt": "Lights stayed on; timers were installed; use fell",
      "steps": [
        "問題耗電。",
        "方案 timer。",
        "結果下降。"
      ],
      "answer": "problem-solution",
      "why": "方案回應問題。"
    }
  ],
  "misconceptions": [
    {
      "belief": "有兩個名詞就是比較。",
      "whyWrong": "還需同一面向的同異。",
      "correction": "找 both/unlike。"
    },
    {
      "belief": "列三項就一定分類。",
      "whyWrong": "需共同分類規則。",
      "correction": "說出分組依據。"
    },
    {
      "belief": "任何後句都是解決方案。",
      "whyWrong": "必須回應前述問題。",
      "correction": "檢查問題是否改善。"
    },
    {
      "belief": "一個例子決定全文結構。",
      "whyWrong": "要看多數句關係。",
      "correction": "從整段判斷。"
    }
  ],
  "checks": [
