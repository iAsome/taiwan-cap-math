  "objectives": [
    "找出程序起始材料與最後觀察。",
    "利用 before、after、then 排序。",
    "依物理必要條件檢查步驟。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U45_ENG_R4_S299_SEC_1",
      "title": "先找準備步驟",
      "content": "measure、label、place 常建立初始狀態。沒有材料就不能先 observe result。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S299_SEC_2",
      "title": "代名詞提供接續",
      "content": "it、the mixture 需前文先建立對象；the cooled water 必須在 cooling 之後。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S299_SEC_3",
      "title": "控制變因要先設定",
      "content": "比較實驗先讓容器、時間等條件一致，再改一個變因。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S299_SEC_4",
      "title": "最後才記錄結果",
      "content": "wait、observe、record 通常在處理之後。不可先寫結果再做處理。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U45_ENG_R4_S299_EX_1",
      "prompt": "Label cups; add water; place one in sun; record",
      "steps": [
        "先 label。",
        "再準備 water。",
        "處理 sun。",
        "最後 record。"
      ],
      "answer": "label → add → place → record",
      "why": "物件狀態逐步建立。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S299_EX_2",
      "prompt": "Heat water; let it cool; measure cooled water",
      "steps": [
        "cooled 回指需先 cool。",
        "cool 需先 heat。",
        "measure 最後。"
      ],
      "answer": "heat → cool → measure",
      "why": "詞形提供順序。"
    },
    {
      "id": "ENG_R4_U45_ENG_R4_S299_EX_3",
      "prompt": "Compare seeds with same water",
      "steps": [
        "先分組。",
        "設定 same water。",
        "再改 light。"
      ],
      "answer": "control first, treatment second",
      "why": "控制條件先建立。"
    }
  ],
  "misconceptions": [
