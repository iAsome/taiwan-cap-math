  "objectives": [
    "辨認單一步驟指令動詞。",
    "把受詞與正確動作配對。",
    "排除同場景但方向相反的行動。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U02_ENG_R4_S008_SEC_1",
      "title": "先抓第一個動詞",
      "content": "Open、circle、underline 常直接開頭；它決定要做什麼。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S008_SEC_2",
      "title": "再抓受詞",
      "content": "Open your book 與 open the window 受詞不同，動作目標不可交換。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S008_SEC_3",
      "title": "位置詞補精確度",
      "content": "Write below the line 與 above 不同；核心動作後再處理位置。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S008_SEC_4",
      "title": "只做一個明示步驟",
      "content": "單一步驟題不自行加交作業、關電腦等後續。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U02_ENG_R4_S008_EX_1",
      "prompt": "Open your book.",
      "steps": [
        "動詞 open。",
        "受詞 book。",
        "執行一次。"
      ],
      "answer": "open the book",
      "why": "不開門。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S008_EX_2",
      "prompt": "Circle the date.",
      "steps": [
        "動詞 circle。",
        "受詞 date。",
        "圈而非抄。"
      ],
      "answer": "circle the date",
      "why": "動作形狀明確。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S008_EX_3",
      "prompt": "Stand beside your chair.",
      "steps": [
        "動詞 stand。",
        "位置 beside chair。",
        "不坐下。"
      ],
      "answer": "stand next to the chair",
      "why": "完整核對。"
    }
  ],
  "misconceptions": [
    {
      "belief": "聽到名詞就忽略動詞。",
      "whyWrong": "會選錯操作。",
      "correction": "動詞先行。"
    },
    {
      "belief": "同一物件任何動作都可。",
      "whyWrong": "circle/underline 不同。",
      "correction": "精確配對。"
    },
    {
      "belief": "自行加第二步。",
      "whyWrong": "超出指令。",
      "correction": "只做明示動作。"
    },
    {
      "belief": "above/below 可互換。",
      "whyWrong": "位置相反。",
      "correction": "做空間核對。"
    }
  ],
  "checks": [
