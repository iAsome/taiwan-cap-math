  "objectives": [
    "依首中尾音檢查拼字。",
    "發現漏字、倒序與錯母音。",
    "用常見正字法確認而非只靠外觀。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U01_ENG_R4_S007_SEC_1",
      "title": "逐段對照",
      "content": "把 fish 分 /f/ /ɪ/ /ʃ/，再檢查 f-i-sh 是否每段都有。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S007_SEC_2",
      "title": "找常見錯誤類型",
      "content": "漏掉 h、交換字母、短母音選錯都會讓聲音或正字法不合。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S007_SEC_3",
      "title": "讀回完整字",
      "content": "選完後從拼字讀回；若讀成另一常見字，如 pen/pin，就需修正。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S007_SEC_4",
      "title": "規則與記憶合作",
      "content": "拼讀提供檢查，但英語正字法有例外；基本字仍需累積正確字形。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U01_ENG_R4_S007_EX_1",
      "prompt": "/f/ /ɪ/ /ʃ/",
      "steps": [
        "f 對 /f/。",
        "i 對短 /ɪ/。",
        "sh 對 /ʃ/。"
      ],
      "answer": "fish",
      "why": "三段完整。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S007_EX_2",
      "prompt": "map vs mab",
      "steps": [
        "尾音 /p/。",
        "p 非 b。",
        "讀回 map。"
      ],
      "answer": "map",
      "why": "清濁核對。"
    },
    {
      "id": "ENG_R4_U01_ENG_R4_S007_EX_3",
      "prompt": "ship vs sip",
      "steps": [
        "首音 /ʃ/。",
        "需 sh。",
        "sip 首音 /s/。"
      ],
      "answer": "ship",
      "why": "避免漏 h。"
    }
  ],
