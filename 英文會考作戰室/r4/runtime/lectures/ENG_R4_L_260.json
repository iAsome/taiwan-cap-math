  "objectives": [
    "找出故事目前尚未完成的目標或問題。",
    "選擇能直接延續人物行動的下一步。",
    "排除突然加入新人物、遠期結局或違背角色目標的選項。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U38_ENG_R4_S260_SEC_1",
      "title": "預測不是寫結局",
      "content": "題目問 next，優先找時間線上緊接的一步，不跳到多年後或整個人生結果。"
    },
    {
      "id": "ENG_R4_U38_ENG_R4_S260_SEC_2",
      "title": "回到未解決目標",
      "content": "人物正在找鑰匙，下一步應繼續檢查可能地點或使用剛得到線索，而非突然參加比賽。"
    },
    {
      "id": "ENG_R4_U38_ENG_R4_S260_SEC_3",
      "title": "最近事件提供入口",
      "content": "門剛打開，下一步可能進入；收到地址，下一步可能前往。用最近動作連接，不另起故事。"
    },
    {
      "id": "ENG_R4_U38_ENG_R4_S260_SEC_4",
      "title": "保留可能性",
      "content": "正確預測是最合線索，不代表現實唯一。選項仍需不超出本文角色、地點與時間。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U38_ENG_R4_S260_EX_1",
      "prompt": "Nora found the address and stood outside the building.",
      "steps": [
        "目標是到達。",
        "已在門外。",
        "下一步可能敲門。"
      ],
      "answer": "She will likely knock or enter.",
      "why": "不跳到回家。"
    },
    {
