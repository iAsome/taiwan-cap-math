  "objectives": [
    "先抓人物與核心物件名詞。",
    "由名詞排除不同物件圖。",
    "再用其餘語意確認唯一圖。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U47_ENG_R4_S309_SEC_1",
      "title": "名詞先行",
      "content": "聽到 camera、umbrella 等內容詞先在四圖找物件，不因人物衣著分心。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S309_SEC_2",
      "title": "同義名稱",
      "content": "bag 可能畫成有把手的袋子；用整體形狀與語境辨認。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S309_SEC_3",
      "title": "人物與物件都核對",
      "content": "若兩圖都有 ball，再用 man/woman 或動作排除。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S309_SEC_4",
      "title": "不從選項反猜",
      "content": "先形成聽到的畫面，再看 A–D。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U47_ENG_R4_S309_EX_1",
      "prompt": "She points to the umbrella.",
      "steps": [
        "抓 umbrella。",
        "找傘形。",
        "核對 points。"
      ],
      "answer": "umbrella picture",
      "why": "名詞先縮小。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S309_EX_2",
      "prompt": "They see a camera.",
      "steps": [
        "they 表多人。",
        "camera 為相機。",
        "兩線索交集。"
      ],
      "answer": "multi-person camera scene",
      "why": "不可只看人數。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S309_EX_3",
      "prompt": "The key is on the table.",
      "steps": [
        "抓 key。",
        "辨認鑰匙。",
        "核對 on。"
      ],
      "answer": "key-on-table scene",
      "why": "名詞與位置共同確認。"
    }
  ],
  "misconceptions": [
    {
      "belief": "只聽到人物就選。",
      "whyWrong": "多圖可能同人數。",
      "correction": "抓核心物件。"
    },
    {
      "belief": "以圖中最大物件作答。",
      "whyWrong": "大小是版面。",
      "correction": "依聽到名詞。"
    },
    {
      "belief": "不熟名詞時猜動作。",
      "whyWrong": "會失去核心區別。",
      "correction": "用字音與其他線索交集。"
    },
    {
      "belief": "看到熟悉物件就停止。",
      "whyWrong": "可能位置不合。",
      "correction": "再核對完整句。"
    }
