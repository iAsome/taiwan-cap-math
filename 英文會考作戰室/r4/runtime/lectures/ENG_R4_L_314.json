  "objectives": [
    "由對比重音找被修正資訊。",
    "區分升調確認與降調陳述。",
    "以語境解釋語調而非只看標點。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U47_ENG_R4_S314_SEC_1",
      "title": "重音回答隱含對比",
      "content": "I wanted the BLUE bag 強調 color，暗含 not another color。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S314_SEC_2",
      "title": "重音位置改焦點",
      "content": "I borrowed it 強調 I 是人物修正；borrowed 強調動作；it 強調物件。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S314_SEC_3",
      "title": "升調常保留確認",
      "content": "一般 yes/no 問句升調表示等待答案；降調較像完整陳述。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S314_SEC_4",
      "title": "語調不是情緒唯一證據",
      "content": "同一升調可表示確認或驚訝，仍需結合字句與情境。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U47_ENG_R4_S314_EX_1",
      "prompt": "I said TUESDAY.",
      "steps": [
        "重音 Tuesday。",
        "對比其他日。",
        "不是人物修正。"
      ],
      "answer": "not another day",
      "why": "焦點為時間。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S314_EX_2",
      "prompt": "SHE called me.",
      "steps": [
        "重音 she。",
        "修正 caller。",
        "動作不變。"
      ],
      "answer": "she, not someone else",
      "why": "主詞焦點。"
    },
    {
      "id": "ENG_R4_U47_ENG_R4_S314_EX_3",
      "prompt": "You're ready? rising",
      "steps": [
        "yes/no。",
        "升調。",
        "等待確認。"
      ],
      "answer": "genuine confirmation",
      "why": "非完成陳述。"
    }
  ],
