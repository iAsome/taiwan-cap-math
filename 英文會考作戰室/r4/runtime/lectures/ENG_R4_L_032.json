{
  "id": "ENG_R4_L_032",
  "subject": "english",
  "unitId": "ENG_R4_U05",
  "skillId": "ENG_R4_S032",
  "authorityRefs": [
    "AUTH-ENGLISH-LC-AD-4-1",
    "AUTH-ENGLISH-LC-B-4-2",
    "AUTH-ENGLISH-LP-1-4-3",
    "AUTH-ENGLISH-LP-3-4-6",
    "AUTH-ENGLISH-LP-5-4-2"
  ],
  "prerequisites": [
    "ENG_R4_S031"
  ],
  "objectives": [
    "建立 this/these 近與 that/those 遠的對比。",
    "把單數與複數形式正確配對。",
    "從手勢、位置與篇章視角推斷距離。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U05_ENG_R4_S032_SEC_1",
      "title": "兩條軸同時判斷",
      "content": "近單 this、遠單 that、近複 these、遠複 those。距離與數缺一不可。"
    },
    {
      "id": "ENG_R4_U05_ENG_R4_S032_SEC_2",
      "title": "名詞與 be 要一致",
      "content": "this book is；these books are；that chair was；those chairs were。不能只換指示詞而忘記名詞數。"
    },
    {
      "id": "ENG_R4_U05_ENG_R4_S032_SEC_3",
      "title": "距離可由語境建立",
      "content": "in my hand 常支持 this/these；across the street 常支持 that/those。篇章中的心理距離也需由文本線索判斷。"
    },
    {
      "id": "ENG_R4_U05_ENG_R4_S032_SEC_4",
      "title": "指示代名詞可獨立使用",
      "content": "This is mine；Those are yours。沒有後接名詞時，仍由所指對象的數與距離決定形式。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U05_ENG_R4_S032_EX_1",
      "prompt": "___ pen in my hand",
      "steps": [
        "pen 單數。",
        "in my hand 表近。",
        "選 this。"
      ],
      "answer": "this pen",
      "why": "近單配對。"
    },
    {
      "id": "ENG_R4_U05_ENG_R4_S032_EX_2",
      "prompt": "___ mountains far away",
      "steps": [
        "mountains 複數。",
        "far away 表遠。",
        "選 those。"
      ],
      "answer": "those mountains",
      "why": "遠複配對。"
    },
    {
      "id": "ENG_R4_U05_ENG_R4_S032_EX_3",
      "prompt": "___ are my keys here.",
      "steps": [
        "keys 複數。",
        "here 表近。",
        "選 These。"
      ],
      "answer": "These are my keys.",
      "why": "近複且與 are 一致。"
    }
  ],
  "misconceptions": [
    {
      "belief": "this 與 these 只差正式度。",
      "whyWrong": "差異在數，不是正式度。",
      "correction": "單數 this，複數 these。"
    },
    {
      "belief": "that 一定指不喜歡的事物。",
      "whyWrong": "核心功能是遠距或篇章指涉。",
      "correction": "除非語境另有態度線索，不推論喜惡。"
    },
    {
      "belief": "遠處複數可用 that。",
      "whyWrong": "that 為單數。",
      "correction": "遠複數用 those。"
    },
    {
      "belief": "指示詞選對後名詞可不變。",
      "whyWrong": "these/those 要搭複數名詞。",
      "correction": "同步檢查名詞與 be。"
    }
  ],
  "checks": [
    {
      "prompt": "近處兩本書用什麼？",
      "answer": "these books。",
      "reason": "近加複數。"
    },
    {
      "prompt": "遠處一棟建築用什麼？",
      "answer": "that building。",
      "reason": "遠加單數。"
    },
    {
      "prompt": "Those 後常搭 is 或 are？",
      "answer": "are。",
      "reason": "複數形式搭複數 be。"
    }
  ],
