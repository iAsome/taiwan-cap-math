  "objectives": [
    "辨認詢問資訊、請求、邀請與道歉。",
    "選擇回答所問功能的自然口語。",
    "排除語法可行但不回應的句子。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U48_ENG_R4_S315_SEC_1",
      "title": "先判功能",
      "content": "Could you...? 是請求；Would you like...? 是邀請；How long...? 要時長。先決定答案類型。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S315_SEC_2",
      "title": "充分而不多答",
      "content": "Where 問地點，回答 At the east gate 即足夠；不需加入無關故事。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S315_SEC_3",
      "title": "禮貌對禮貌",
      "content": "道歉常回 That's all right；感謝常回 You're welcome。不能只做字面配對。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S315_SEC_4",
      "title": "時態與人物一致",
      "content": "Did you...? 用過去回答；Can you...? 回能力或接受，不把主詞角色交換。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U48_ENG_R4_S315_EX_1",
      "prompt": "Could you open the window?",
      "steps": [
        "功能請求。",
        "可接受或拒絕。",
        "選 Sure。"
      ],
      "answer": "Sure, I'll do it.",
      "why": "直接回應且禮貌。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S315_EX_2",
      "prompt": "How long is the trip?",
      "steps": [
        "how long 要時長。",
        "不是距離地點。",
        "給 two hours。"
      ],
      "answer": "About two hours.",
      "why": "答案類型正確。"
    },
    {
      "id": "ENG_R4_U48_ENG_R4_S315_EX_3",
      "prompt": "I'm sorry I'm late.",
      "steps": [
        "辨道歉。",
        "可接受。",
        "不回答時間。"
      ],
      "answer": "That's all right.",
      "why": "社交配對。"
    }
  ],
