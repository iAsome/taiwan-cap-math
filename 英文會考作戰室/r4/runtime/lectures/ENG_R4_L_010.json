  "objectives": [
    "看懂 choose、complete、rewrite 等指示。",
    "讀取數量與格式限制。",
    "區分題目內容與操作語。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U02_ENG_R4_S010_SEC_1",
      "title": "指示動詞不是文章內容",
      "content": "Explain the reason 中 explain 是操作；reason 才是輸出內容。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S010_SEC_2",
      "title": "數量詞是硬限制",
      "content": "Write two examples 不能交一例或三例。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S010_SEC_3",
      "title": "格式詞決定產出",
      "content": "in a full sentence、in order、in the chart 會限制答案形式。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S010_SEC_4",
      "title": "多個限制取交集",
      "content": "Choose one and explain why 需選一項再給理由。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U02_ENG_R4_S010_EX_1",
      "prompt": "Complete the chart.",
      "steps": [
        "動詞 complete。",
        "目標 chart。",
        "填缺格。"
      ],
      "answer": "fill missing chart information",
      "why": "不是畫新圖。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S010_EX_2",
      "prompt": "Rewrite in past tense.",
      "steps": [
        "rewrite。",
        "形式 past tense。",
        "意思保留。"
      ],
      "answer": "change tense, not event",
      "why": "格式控制。"
    },
    {
      "id": "ENG_R4_U02_ENG_R4_S010_EX_3",
      "prompt": "Give two reasons.",
      "steps": [
