  "prerequisites": [
    "ENG_R4_S036"
  ],
  "objectives": [
    "掌握 child/children、man/men 等高頻不規則。",
    "辨識 sheep 等單複數同形。",
    "避免在不規則複數上再加 s。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U06_ENG_R4_S037_SEC_1",
      "title": "內部母音或整體改變",
      "content": "man→men、woman→women、tooth→teeth、foot→feet、mouse→mice，不是加一般字尾。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S037_SEC_2",
      "title": "另有複數詞尾",
      "content": "child→children、person→people。這些形式需作完整詞彙記憶。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S037_SEC_3",
      "title": "單複數同形",
      "content": "one sheep/two sheep、one deer/two deer。數量與動詞揭示數，不靠名詞字尾。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S037_SEC_4",
      "title": "不重複標記複數",
      "content": "children、people、mice 已是複數，標準用法不再加 -s。把詞形放入 these ... are 檢查。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U06_ENG_R4_S037_EX_1",
      "prompt": "three ___ (child)",
      "steps": [
        "three 要求複數。",
        "child 不規則。",
        "取 children。"
      ],
      "answer": "children",
      "why": "不是 childs。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S037_EX_2",
      "prompt": "many ___ (person)",
      "steps": [
        "many 表複數。",
        "person 的常見複數是 people。",
        "搭複數動詞。"
      ],
      "answer": "people",
      "why": "people 已含複數。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S037_EX_3",
      "prompt": "two ___ (sheep)",
      "steps": [
        "two 表複數。",
        "sheep 單複數同形。",
        "不再加 s。"
      ],
      "answer": "sheep",
      "why": "由 two 判斷數。"
    }
  ],
  "misconceptions": [
    {
      "belief": "不規則名詞也先加 s。",
      "whyWrong": "詞形可能整體改變。",
      "correction": "直接記憶與查證正式複數。"
    },
    {
      "belief": "children 後可再加 s 更明確。",
      "whyWrong": "children 已是複數。",
      "correction": "不寫 childrens。"
    },
    {
      "belief": "沒有 s 就一定單數。",
      "whyWrong": "sheep、deer 可為複數。",
      "correction": "看數量詞與動詞。"
    },
    {
      "belief": "people 是 person 加了看不見的 s。",
      "whyWrong": "它是獨立不規則詞形。",
      "correction": "將 person/people 當配對學習。"
    }
  ],
  "checks": [
    {
      "prompt": "mouse 的複數是什麼？",
      "answer": "mice。",
      "reason": "內部母音改變。"
    },
    {
      "prompt": "two sheep 是否正確？",
      "answer": "正確。",
      "reason": "sheep 單複數同形。"
    },
    {
      "prompt": "children 是否需再加 s？",
      "answer": "不需要。",
      "reason": "它已是複數。"
    }
  ],
