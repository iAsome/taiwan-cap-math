  ],
  "prerequisites": [
    "ENG_R4_S037"
  ],
  "objectives": [
    "區分可直接計數的個體與整體物質概念。",
    "用單位詞計量不可數名詞。",
    "辨識 chicken、paper 等依語意改變可數性的詞。"
  ],
  "sections": [
    {
      "id": "ENG_R4_U06_ENG_R4_S038_SEC_1",
      "title": "可數名詞有個體單位",
      "content": "one chair/two chairs，可與 a/an、many、few 搭配。複數形式能直接表示多個。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S038_SEC_2",
      "title": "不可數名詞視為整體",
      "content": "water、information、furniture 常與 much、little、some 搭配，不能直接說 two informations。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S038_SEC_3",
      "title": "單位詞把物質切成可數",
      "content": "two bottles of water、three pieces of information。數量落在 bottles/pieces，不改變 water/information 本身。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S038_SEC_4",
      "title": "同一詞可依意義轉換",
      "content": "chicken 可指不可數雞肉，也可指一隻可數雞；paper 可指材料或一份文章。上下文比詞表更重要。"
    }
  ],
  "workedExamples": [
    {
      "id": "ENG_R4_U06_ENG_R4_S038_EX_1",
      "prompt": "three ___ of advice",
      "steps": [
        "advice 不可數。",
        "需要可數單位。",
        "piece 複數化。"
      ],
      "answer": "three pieces of advice",
      "why": "advice 保持原形。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S038_EX_2",
      "prompt": "There are two chickens.",
      "steps": [
        "有 two。",
        "名詞複數。",
        "此處指兩隻動物。"
      ],
      "answer": "chickens are countable animals here",
      "why": "語境決定可數義。"
    },
    {
      "id": "ENG_R4_U06_ENG_R4_S038_EX_3",
      "prompt": "We need some chicken.",
      "steps": [
        "some 可搭物質。",
        "沒有個體單位。",
        "此處指食物雞肉。"
      ],
      "answer": "chicken is noncount food here",
      "why": "同一詞改為物質義。"
    }
  ],
  "misconceptions": [
    {
      "belief": "名詞永遠只有一種可數性。",
      "whyWrong": "部分名詞依語意改變。",
      "correction": "讀完整語境再分類。"
    },
    {
      "belief": "不可數名詞完全不能計量。",
      "whyWrong": "可用容器或單位詞。",
      "correction": "數量標記放在單位名詞上。"
    },
    {
      "belief": "加 s 就能把任何不可數名詞變多。",
      "whyWrong": "informations、furnitures 非目標標準用法。",
      "correction": "用 pieces/items of。"
    },
    {
      "belief": "some 只搭不可數名詞。",
      "whyWrong": "some 也可搭複數可數名詞。",
      "correction": "看後方名詞數與語意。"
    }
  ],
  "checks": [
    {
      "prompt": "information 可直接說 two informations 嗎？",
      "answer": "不可以。",
      "reason": "用 two pieces of information。"
    },
    {
      "prompt": "a glass of milk 中可數的是什麼？",
      "answer": "glass。",
      "reason": "milk 保持不可數物質概念。"
    },
    {
      "prompt": "chicken 一定不可數嗎？",
      "answer": "不一定。",
      "reason": "可指雞肉或雞隻。"
    }
  ],
