      "紀錄內容",
      "審查用途"
    ],
    "rows": [
      [
        "可驗證命題",
        "能源效率＝有用輸出能量÷總輸入能量×100%；輸入 500 J、有用輸出 150 J 的效率為 30%。",
        "與觀察或計算結果比對"
      ],
      [
        "同學甲的主張",
        "能源效率＝總輸入÷有用輸出×100%，因此可輕易超過 100% 且持續創能。",
        "找出迷思與反例"
      ],
