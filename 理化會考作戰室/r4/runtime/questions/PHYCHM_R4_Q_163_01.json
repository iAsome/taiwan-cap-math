  "stem": "一列波的頻率為 5.0 Hz、波長為 0.80 m，波速為何？",
  "options": [
    "6.25 m/s",
    "0.16 m/s",
    "5.8 m/s",
    "4.0 m/s"
  ],
  "answerIndex": 3,
  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": false,
      "reason": "6.25 是以頻率除以波長，並非 v＝fλ。"
    },
    {
      "optionIndex": 1,
      "isCorrect": false,
      "reason": "0.16 是以波長除以頻率，單位也不是波速。"
    },
    {
      "optionIndex": 2,
      "isCorrect": false,
      "reason": "把 5.0 與 0.80 相加不符合波速關係。"
    },
    {
      "optionIndex": 3,
      "isCorrect": true,
      "reason": "v＝fλ＝5.0×0.80＝4.0 m/s。"
    }
