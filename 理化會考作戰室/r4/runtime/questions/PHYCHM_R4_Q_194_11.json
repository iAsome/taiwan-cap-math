  "optionRationales": [
    {
      "optionIndex": 0,
      "isCorrect": false,
      "reason": "凹透鏡使近物光更發散，不能補足會聚能力。"
    },
    {
      "optionIndex": 1,
      "isCorrect": true,
      "reason": "老花眼近距離調節不足時，可用凸透鏡增加會聚，使近物像形成在視網膜。"
